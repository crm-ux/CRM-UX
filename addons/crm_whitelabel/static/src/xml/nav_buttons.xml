<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <!-- 1st & 2nd: Dashboard button before main buttons (New is in o_control_panel_main_buttons or custom New) -->
        <xpath expr="//div[hasclass('o_control_panel_main_buttons')]" position="before">
            <!-- 1st: Dashboard button -->
            <button class="btn btn-secondary" t-on-click="goDashboard">Dashboard</button>

            <!-- 2nd: Explicit New button for Lead creation when in Total Pipeline view -->
            <button class="btn btn-primary" t-if="isTotalPipelineView" t-on-click="createNewLead">New</button>
        </xpath>

        <!-- Dropdowns placed AFTER New (o_control_panel_main_buttons) so Dashboard (1st) and New (2nd) are always together -->
        <xpath expr="//div[hasclass('o_control_panel_main_buttons')]" position="after">
            <!-- Stage Dropdown with matching height -->
            <div class="d-inline-flex align-items-center me-2" t-if="isTotalPipelineView">
                <select class="form-select form-select-sm text-start" t-on-change="onStageFilterChange" 
                        style="height: clamp(2.1rem, 3.2vh, 2.7rem); padding: 0 clamp(1.8rem, 2.2vw, 2.2rem) 0 clamp(0.6rem, 0.9vw, 0.85rem); font-size: clamp(0.78rem, 0.88vw, 0.85rem); font-weight: 500; border-color: #0b3d91; color: #0b3d91; background-color: #fff; background-position: right 0.75rem center; line-height: 1.5; border-radius: clamp(0.25rem, 0.4vw, 0.375rem); cursor: pointer;">
                    <option value="all" t-att-selected="currentStageFilter == 'all'">All Stages</option>
                    <option value="0" t-att-selected="currentStageFilter == '0'">Lead</option>
                    <option value="5" t-att-selected="currentStageFilter == '5'">Contacted</option>
                    <option value="7" t-att-selected="currentStageFilter == '7'">Tech. Discussion</option>
                    <option value="10" t-att-selected="currentStageFilter == '10'">Qualified</option>
                    <option value="20" t-att-selected="currentStageFilter == '20'">Opportunity</option>
                    <option value="30" t-att-selected="currentStageFilter == '30'">Quotes</option>
                    <option value="35" t-att-selected="currentStageFilter == '35'">Sent</option>
                    <option value="40" t-att-selected="currentStageFilter == '40'">Negotiation</option>
                    <option value="50" t-att-selected="currentStageFilter == '50'">Order Expected</option>
                    <option value="90" t-att-selected="currentStageFilter == '90'">Won</option>
                </select>
            </div>

            <!-- Dynamic Employee / Team Member Filter (Visible only when user can access > 1 employee) -->
            <div class="d-inline-flex align-items-center me-2" t-if="showEmployeeFilter">
                <select class="form-select form-select-sm text-start" t-on-change="onEmployeeFilterChange"
                        style="height: clamp(2.1rem, 3.2vh, 2.7rem); padding: 0 clamp(1.8rem, 2.2vw, 2.2rem) 0 clamp(0.6rem, 0.9vw, 0.85rem); font-size: clamp(0.78rem, 0.88vw, 0.85rem); font-weight: 500; border-color: #0b3d91; color: #0b3d91; background-color: #fff; background-position: right 0.75rem center; line-height: 1.5; border-radius: clamp(0.25rem, 0.4vw, 0.375rem); cursor: pointer;">
                    <option value="all" t-att-selected="currentEmployeeFilter == 'all'">All Members</option>
                    <t t-foreach="accessibleEmployees" t-as="emp" t-key="emp.id">
                        <option t-att-value="emp.id" t-att-selected="currentEmployeeFilter == emp.id.toString()">
                            <t t-esc="emp.name"/>
                        </option>
                    </t>
                </select>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_control_panel_main_buttons')]" position="attributes">
            <attribute name="t-att-class">isTotalPipelineView ? 'd-none' : ''</attribute>
        </xpath>
    </t>
</templates>
