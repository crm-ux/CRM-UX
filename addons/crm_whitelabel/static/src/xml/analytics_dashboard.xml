<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="crm_whitelabel.AnalyticsDashboard" owl="1">
        <div class="crm-analytics-page">
            <!-- STANDARD ODOO CONTROL PANEL NAVBAR -->
            <div class="o_control_panel border-bottom bg-view">
                <div class="o_control_panel_main d-flex justify-content-between align-items-center">
                    <div class="o_control_panel_breadcrumbs">
                        <button type="button" class="btn btn-secondary" t-on-click="goToDashboard">
                            Dashboard
                        </button>
                        <div class="o_breadcrumb">
                            <span class="active">Analytics &amp; Insights</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- MAIN CONTENT CONTAINER -->
            <main class="crm-analytics-container">
                <!-- HEADER TITLE & TAB NAVIGATION -->
                <div class="crm-analytics-header">
                    <div class="crm-analytics-title-box">
                        <h2>Business Performance &amp; Reports</h2>
                        <p>Detailed breakdown and metrics across departments</p>
                    </div>

                    <!-- TAB BAR -->
                    <div class="crm-analytics-tabs">
                        <button type="button" 
                                class="crm-analytics-tab-btn" 
                                t-att-class="state.activeTab === 'sales' ? 'active' : ''" 
                                t-on-click="() => this.setTab('sales')">
                            <i class="fa fa-line-chart"></i>
                            <span>Sales &amp; Revenue</span>
                        </button>
                        <button type="button" 
                                class="crm-analytics-tab-btn" 
                                t-att-class="state.activeTab === 'leads' ? 'active' : ''" 
                                t-on-click="() => this.setTab('leads')">
                            <i class="fa fa-filter"></i>
                            <span>Pipeline Insights</span>
                        </button>
                        <button type="button" 
                                class="crm-analytics-tab-btn" 
                                t-att-class="state.activeTab === 'amc' ? 'active' : ''" 
                                t-on-click="() => this.setTab('amc')">
                            <i class="fa fa-shield"></i>
                            <span>AMC &amp; Contracts</span>
                        </button>
                        <button type="button" 
                                class="crm-analytics-tab-btn" 
                                t-att-class="state.activeTab === 'service' ? 'active' : ''" 
                                t-on-click="() => this.setTab('service')">
                            <i class="fa fa-wrench"></i>
                            <span>Service &amp; Operations</span>
                        </button>
                    </div>
                </div>

                <!-- TAB PANELS (BLANK / PLACEHOLDER FOR NOW) -->
                <div class="crm-analytics-body">
                    <!-- TAB 1: Sales & Revenue -->
                    <div t-if="state.activeTab === 'sales'" class="crm-tab-panel">
                        <div class="crm-tab-placeholder">
                            <div class="crm-tab-placeholder-icon">
                                <i class="fa fa-line-chart"></i>
                            </div>
                            <h3>Sales &amp; Revenue Analytics</h3>
                            <p>This tab is ready. We will add the custom sales analytics here.</p>
                        </div>
                    </div>

                    <!-- TAB 2: Lead Funnel -->
                    <div t-if="state.activeTab === 'leads'" class="crm-tab-panel">
                        <div class="crm-an-quad-wrapper">
                            <!-- Inner Header & Embedded Strip INSIDE the box -->
                            <div class="crm-an-quad-header">
                                <div class="crm-an-quad-title-group">
                                    <h3 class="crm-an-quad-title">Customer Classification</h3>
                                    <p class="crm-an-quad-subtitle">Customer vs Product occupancy and Won revenue distribution</p>
                                </div>
                                <div class="crm-an-quad-strip">
                                    <span class="crm-an-strip-item">Total Pipeline: <strong><t t-esc="state.totalPipelineLeads"/> Leads</strong></span>
                                    <span class="crm-an-strip-dot">•</span>
                                    <span class="crm-an-strip-item">Classified: <strong><t t-esc="state.classifiedLeadsCount"/></strong></span>
                                    <span class="crm-an-strip-dot">•</span>
                                    <span t-if="state.unclassifiedCount > 0" 
                                          class="crm-an-unclass-badge clickable" 
                                          t-on-click="openUnclassifiedLeads" 
                                          title="Click to view unclassified leads">
                                        <t t-esc="state.unclassifiedCount"/> Unclassified
                                    </span>
                                    <span t-else="" class="crm-an-unclass-badge zero">
                                        0 Unclassified
                                    </span>
                                    <span class="crm-an-strip-dot">•</span>
                                    <span class="crm-an-strip-item">Won Revenue: <strong style="color: #16a34a;"><t t-esc="fmt(state.totalWonValue)"/></strong></span>
                                </div>
                            </div>

                            <!-- Single Connected 2x2 Rounded Matrix Box (No random icons, pure clean layout) -->
                            <div class="crm-an-quad-box">
                                <t t-foreach="state.matrixData" t-as="item" t-key="item.key">
                                    <div class="crm-an-quad-cell" 
                                         t-att-class="item.colorClass"
                                         t-on-click="() => this.openQuadrantLeads(item.key, item.name)">
                                        <div class="crm-an-cell-title">
                                            <t t-esc="item.name"/>
                                        </div>
                                        <div class="crm-an-cell-stats">
                                            <span class="crm-an-cell-count"><t t-esc="item.count"/> Leads</span>
                                            <span class="crm-an-cell-badge"><t t-esc="item.percent"/>%</span>
                                        </div>
                                        <div class="crm-an-cell-value">
                                            Won Value: <strong><t t-esc="fmt(item.wonValue)"/></strong>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- QUOTE PRICING & DISCOUNT IMPACT -->
                        <div class="crm-an-disc-wrapper">
                            <div class="crm-an-disc-header">
                                <div class="crm-an-disc-title-group">
                                    <h3 class="crm-an-disc-title">Quote Pricing &amp; Discount Impact</h3>
                                    <p class="crm-an-disc-subtitle">Breakdown of quotes closed at full price vs negotiated discounts</p>
                                </div>
                                <div class="crm-an-disc-header-stat">
                                    <span class="crm-an-disc-stat-label">Total Quotes Analyzed:</span>
                                    <strong class="crm-an-disc-stat-val"><t t-esc="state.quoteDiscount.totalQuotes"/> Quotes</strong>
                                </div>
                            </div>

                            <!-- SPLIT LAYOUT: Donut Chart on Left, Clean Details on Right -->
                            <div class="crm-an-disc-split">
                                <!-- LEFT SIDE: Pure Clean Donut Chart (Nothing added inside/over it) -->
                                <div class="crm-an-donut-col">
                                    <div class="crm-an-donut-chart-box">
                                        <div class="crm-an-donut-ring" t-att-style="state.quoteDiscount.donutStyle || ''">
                                            <div class="crm-an-donut-hole">
                                                <div class="crm-an-donut-center">
                                                    <span class="crm-an-center-num"><t t-esc="state.quoteDiscount.totalQuotes"/></span>
                                                    <span class="crm-an-center-lbl">Quotes</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- RIGHT SIDE: Details List & Breakdown -->
                                <div class="crm-an-details-col">

                            <!-- 4 Classification Rows with Values -->
                            <div class="crm-an-disc-list">
                                <div class="crm-an-disc-row clickable" t-on-click="() => this.openDiscountQuotes('full_price', 'Full Price')">
                                    <div class="crm-an-row-left">
                                        <span class="crm-an-dot crm-dot-green"></span>
                                        <span class="crm-an-row-name">Full Price (0% Disc)</span>
                                    </div>
                                    <div class="crm-an-row-right">
                                        <span class="crm-an-row-pct"><t t-esc="state.quoteDiscount.tiers.full_price.pct"/>%</span>
                                        <span class="crm-an-row-count"><strong><t t-esc="state.quoteDiscount.tiers.full_price.count"/></strong> Quotes</span>
                                        <span class="crm-an-row-val">(<strong style="color: #16a34a;">₹0 Disc</strong>)</span>
                                    </div>
                                </div>

                                <div class="crm-an-disc-row clickable" t-on-click="() => this.openDiscountQuotes('small_disc', '1-5%')">
                                    <div class="crm-an-row-left">
                                        <span class="crm-an-dot crm-dot-yellow"></span>
                                        <span class="crm-an-row-name">Small Disc (1–5%)</span>
                                    </div>
                                    <div class="crm-an-row-right">
                                        <span class="crm-an-row-pct"><t t-esc="state.quoteDiscount.tiers.small_disc.pct"/>%</span>
                                        <span class="crm-an-row-count"><strong><t t-esc="state.quoteDiscount.tiers.small_disc.count"/></strong> Quotes</span>
                                        <span class="crm-an-row-val">(<strong><t t-esc="fmt(state.quoteDiscount.tiers.small_disc.discount)"/></strong> Disc)</span>
                                    </div>
                                </div>

                                <div class="crm-an-disc-row clickable" t-on-click="() => this.openDiscountQuotes('med_disc', '5-10%')">
                                    <div class="crm-an-row-left">
                                        <span class="crm-an-dot crm-dot-orange"></span>
                                        <span class="crm-an-row-name">Med Disc (5–10%)</span>
                                    </div>
                                    <div class="crm-an-row-right">
                                        <span class="crm-an-row-pct"><t t-esc="state.quoteDiscount.tiers.med_disc.pct"/>%</span>
                                        <span class="crm-an-row-count"><strong><t t-esc="state.quoteDiscount.tiers.med_disc.count"/></strong> Quotes</span>
                                        <span class="crm-an-row-val">(<strong><t t-esc="fmt(state.quoteDiscount.tiers.med_disc.discount)"/></strong> Disc)</span>
                                    </div>
                                </div>

                                <div class="crm-an-disc-row clickable" t-on-click="() => this.openDiscountQuotes('heavy_disc', '>10%')">
                                    <div class="crm-an-row-left">
                                        <span class="crm-an-dot crm-dot-red"></span>
                                        <span class="crm-an-row-name">Heavy Disc (&gt;10%)</span>
                                    </div>
                                    <div class="crm-an-row-right">
                                        <span class="crm-an-row-pct"><t t-esc="state.quoteDiscount.tiers.heavy_disc.pct"/>%</span>
                                        <span class="crm-an-row-count"><strong><t t-esc="state.quoteDiscount.tiers.heavy_disc.count"/></strong> Quotes</span>
                                        <span class="crm-an-row-val">(<strong style="color: #dc2626;"><t t-esc="fmt(state.quoteDiscount.tiers.heavy_disc.discount)"/></strong> Disc)</span>
                                    </div>
                                </div>
                            </div>

                                    <!-- Bottom Summary Strip: Total Discount Given -->
                                    <div class="crm-an-disc-footer clickable" t-on-click="() => this.openDiscountQuotes('all_discounted', 'All Discounted')">
                                        <div class="crm-an-footer-content">
                                            <i class="fa fa-tag crm-an-footer-icon"></i>
                                            <span>Total Discount Given: <strong style="color: #dc2626;"><t t-esc="fmt(state.quoteDiscount.totalDiscountAmount)"/></strong> (Across <strong><t t-esc="state.quoteDiscount.discountedQuotesCount"/></strong> Discounted Quotes)</span>
                                        </div>
                                        <span class="crm-an-footer-hint">View Deals →</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 3: AMC & Contracts -->
                    <div t-if="state.activeTab === 'amc'" class="crm-tab-panel">
                        <div class="crm-tab-placeholder">
                            <div class="crm-tab-placeholder-icon">
                                <i class="fa fa-shield"></i>
                            </div>
                            <h3>AMC &amp; Contracts Analytics</h3>
                            <p>This tab is ready. We will add the custom AMC analytics here.</p>
                        </div>
                    </div>

                    <!-- TAB 4: Service & Operations -->
                    <div t-if="state.activeTab === 'service'" class="crm-tab-panel">
                        <div class="crm-tab-placeholder">
                            <div class="crm-tab-placeholder-icon">
                                <i class="fa fa-wrench"></i>
                            </div>
                            <h3>Service &amp; Operations Analytics</h3>
                            <p>This tab is ready. We will add the custom service analytics here.</p>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </t>
</templates>
