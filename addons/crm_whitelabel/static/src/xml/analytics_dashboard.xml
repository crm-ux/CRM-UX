<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="crm_whitelabel.AnalyticsDashboard" owl="1">
        <div class="crm-analytics-page">
            <!-- STANDARD ODOO CONTROL PANEL NAVBAR -->
            <div class="o_control_panel border-bottom bg-view">
                <div class="o_control_panel_main d-flex justify-content-between align-items-center">
                    <div class="o_control_panel_breadcrumbs">
                        <button type="button" class="btn btn-secondary" t-on-click="goToDashboard">
                            Dashboard
                        </button>
                        <div class="o_breadcrumb">
                            <span class="active">Analytics &amp; Insights</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- MAIN CONTENT CONTAINER -->
            <main class="crm-analytics-container">
                <!-- HEADER TITLE & TAB NAVIGATION -->
                <div class="crm-analytics-header">
                    <div class="crm-analytics-title-box">
                        <h2>Business Performance &amp; Reports</h2>
                        <p>Detailed breakdown and metrics across departments</p>
                    </div>

                    <!-- TAB BAR -->
                    <div class="crm-analytics-tabs">
                        <button type="button" 
                                class="crm-analytics-tab-btn" 
                                t-att-class="state.activeTab === 'sales' ? 'active' : ''" 
                                t-on-click="() => this.setTab('sales')">
                            <i class="fa fa-line-chart"></i>
                            <span>Sales &amp; Revenue</span>
                        </button>
                        <button type="button" 
                                class="crm-analytics-tab-btn" 
                                t-att-class="state.activeTab === 'leads' ? 'active' : ''" 
                                t-on-click="() => this.setTab('leads')">
                            <i class="fa fa-filter"></i>
                            <span>Lead Funnel</span>
                        </button>
                        <button type="button" 
                                class="crm-analytics-tab-btn" 
                                t-att-class="state.activeTab === 'amc' ? 'active' : ''" 
                                t-on-click="() => this.setTab('amc')">
                            <i class="fa fa-shield"></i>
                            <span>AMC &amp; Contracts</span>
                        </button>
                        <button type="button" 
                                class="crm-analytics-tab-btn" 
                                t-att-class="state.activeTab === 'service' ? 'active' : ''" 
                                t-on-click="() => this.setTab('service')">
                            <i class="fa fa-wrench"></i>
                            <span>Service &amp; Operations</span>
                        </button>
                    </div>
                </div>

                <!-- TAB PANELS (BLANK / PLACEHOLDER FOR NOW) -->
                <div class="crm-analytics-body">
                    <!-- TAB 1: Sales & Revenue -->
                    <div t-if="state.activeTab === 'sales'" class="crm-tab-panel">
                        <div class="crm-tab-placeholder">
                            <div class="crm-tab-placeholder-icon">
                                <i class="fa fa-line-chart"></i>
                            </div>
                            <h3>Sales &amp; Revenue Analytics</h3>
                            <p>This tab is ready. We will add the custom sales analytics here.</p>
                        </div>
                    </div>

                    <!-- TAB 2: Lead Funnel -->
                    <div t-if="state.activeTab === 'leads'" class="crm-tab-panel">
                        <div class="crm-an-quad-wrapper">
                            <!-- Inner Header & Embedded Strip INSIDE the box -->
                            <div class="crm-an-quad-header">
                                <div class="crm-an-quad-title-group">
                                    <h3 class="crm-an-quad-title">Customer Classification</h3>
                                    <p class="crm-an-quad-subtitle">Customer vs Product occupancy and Won revenue distribution</p>
                                </div>
                                <div class="crm-an-quad-strip">
                                    <span class="crm-an-strip-item">Total Pipeline: <strong><t t-esc="state.totalPipelineLeads"/> Leads</strong></span>
                                    <span class="crm-an-strip-dot">•</span>
                                    <span class="crm-an-strip-item">Classified: <strong><t t-esc="state.classifiedLeadsCount"/></strong></span>
                                    <span class="crm-an-strip-dot">•</span>
                                    <span t-if="state.unclassifiedCount > 0" 
                                          class="crm-an-unclass-badge clickable" 
                                          t-on-click="openUnclassifiedLeads" 
                                          title="Click to view unclassified leads">
                                        <t t-esc="state.unclassifiedCount"/> Unclassified
                                    </span>
                                    <span t-else="" class="crm-an-unclass-badge zero">
                                        0 Unclassified
                                    </span>
                                    <span class="crm-an-strip-dot">•</span>
                                    <span class="crm-an-strip-item">Won Revenue: <strong style="color: #16a34a;"><t t-esc="fmt(state.totalWonValue)"/></strong></span>
                                </div>
                            </div>

                            <!-- Single Connected 2x2 Rounded Matrix Box (No random icons, pure clean layout) -->
                            <div class="crm-an-quad-box">
                                <t t-foreach="state.matrixData" t-as="item" t-key="item.key">
                                    <div class="crm-an-quad-cell" t-att-class="item.colorClass">
                                        <div class="crm-an-cell-title">
                                            <t t-esc="item.name"/>
                                        </div>
                                        <div class="crm-an-cell-stats">
                                            <span class="crm-an-cell-count"><t t-esc="item.count"/> Leads</span>
                                            <span class="crm-an-cell-badge"><t t-esc="item.percent"/>%</span>
                                        </div>
                                        <div class="crm-an-cell-value">
                                            Won Value: <strong><t t-esc="fmt(item.wonValue)"/></strong>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 3: AMC & Contracts -->
                    <div t-if="state.activeTab === 'amc'" class="crm-tab-panel">
                        <div class="crm-tab-placeholder">
                            <div class="crm-tab-placeholder-icon">
                                <i class="fa fa-shield"></i>
                            </div>
                            <h3>AMC &amp; Contracts Analytics</h3>
                            <p>This tab is ready. We will add the custom AMC analytics here.</p>
                        </div>
                    </div>

                    <!-- TAB 4: Service & Operations -->
                    <div t-if="state.activeTab === 'service'" class="crm-tab-panel">
                        <div class="crm-tab-placeholder">
                            <div class="crm-tab-placeholder-icon">
                                <i class="fa fa-wrench"></i>
                            </div>
                            <h3>Service &amp; Operations Analytics</h3>
                            <p>This tab is ready. We will add the custom service analytics here.</p>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </t>
</templates>
