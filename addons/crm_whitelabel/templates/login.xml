<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_custom" name="CRM Login Branding" inherit_id="web.login" priority="20">
        <xpath expr="//div[@id='oe_structure_login_top']" position="after">
            <div class="text-center" style="padding-top:30px;margin-bottom:20px;">
                <div style="width:60px;height:60px;background:#1a3d6e;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px;">
                    <span style="color:white;font-size:28px;font-weight:800;">Y</span>
                </div>
                <div style="font-size:22px;font-weight:800;color:#1a3d6e;">YantraConnect CRM</div>
                <div style="font-size:12px;color:#64748B;margin-top:4px;">Sales and Lead Management</div>
            </div>
        </xpath>
        <xpath expr="//button[@type='submit']" position="attributes">
            <attribute name="style">background:#1a3d6e !important;border-color:#1a3d6e !important;color:#fff !important;</attribute>
            <attribute name="onclick">this.innerHTML='&lt;span style=&quot;display:inline-block;width:16px;height:16px;border:2px solid #fff;border-top-color:transparent;border-radius:50%;animation:crm-spin 0.7s linear infinite;vertical-align:middle;&quot;&gt;&lt;/span&gt; Signing in...';this.disabled=true;this.form.submit();</attribute>
        </xpath>
        <xpath expr="//form" position="inside">
            <style>@keyframes crm-spin{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}</style>
        </xpath>
    </template>

    <!-- Temporarily hide Forgot Password / Reset Password link from login -->
    <template id="auth_signup_login_custom" name="CRM Auth Signup Login Custom" inherit_id="auth_signup.login" priority="20">
        <xpath expr="//a[contains(@t-attf-href, 'reset_password')]" position="replace"/>
    </template>

    <template id="reset_password_custom" name="CRM Reset Password Branding" inherit_id="auth_signup.reset_password" priority="20">
        <xpath expr="//button[@type='submit']" position="attributes">
            <attribute name="style">background:#1a3d6e !important;border-color:#1a3d6e !important;color:#fff !important;</attribute>
        </xpath>
    </template>

    <template id="hide_website_nav" inherit_id="website.navbar" priority="99">
        <xpath expr="//nav" position="attributes">
            <attribute name="style">display:none !important;</attribute>
        </xpath>
    </template>

    <!-- Global Custom Favicon & Page Title -->
    <template id="custom_favicon" inherit_id="web.layout" priority="99">
        <xpath expr="//title" position="replace">
            <title>YantraConnect CRM</title>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link rel="shortcut icon" href="/crm_whitelabel/static/src/img/favicon.png" type="image/png"/>
            <link rel="icon" href="/crm_whitelabel/static/src/img/favicon.png" type="image/png"/>
            <link rel="apple-touch-icon" href="/crm_whitelabel/static/src/img/favicon.png"/>
            <link rel="apple-touch-icon" sizes="180x180" href="/crm_whitelabel/static/src/img/favicon.png"/>
        </xpath>
    </template>

</odoo>