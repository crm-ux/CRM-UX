<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_custom" name="CRM Login Branding" inherit_id="web.login" priority="20">
        <xpath expr="//div[@id='oe_structure_login_top']" position="after">
            <div class="text-center" style="padding-top:30px;margin-bottom:20px;">
                <div style="width:60px;height:60px;background:#1a3d6e;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px;">
                    <span style="color:white;font-size:28px;font-weight:800;">Y</span>
                </div>
                <div style="font-size:22px;font-weight:800;color:#1a3d6e;">YantraConnect CRM</div>
                <div style="font-size:12px;color:#64748B;margin-top:4px;">Sales and Lead Management</div>
            </div>
        </xpath>
        <xpath expr="//button[@type='submit']" position="attributes">
            <attribute name="style">background:#1a3d6e !important;border-color:#1a3d6e !important;color:#fff !important;</attribute>
            <attribute name="onclick">this.innerHTML='&lt;span style=&quot;display:inline-block;width:16px;height:16px;border:2px solid #fff;border-top-color:transparent;border-radius:50%;animation:crm-spin 0.7s linear infinite;vertical-align:middle;&quot;&gt;&lt;/span&gt; Signing in...';this.disabled=true;this.form.submit();</attribute>
        </xpath>
        <xpath expr="//form" position="inside">
            <style>@keyframes crm-spin{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}</style>
        </xpath>
    </template>

    <!-- Reset Password / Forgot Password link enabled -->

    <template id="reset_password_custom" name="CRM Reset Password Branding" inherit_id="auth_signup.reset_password" priority="20">
        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="col-form-label" style="font-weight: 600; color: #1e293b;">Username</label>
        </xpath>
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="placeholder">Enter your username</attribute>
        </xpath>
        <xpath expr="//button[@type='submit']" position="attributes">
            <attribute name="style">background:#1a3d6e !important;border-color:#1a3d6e !important;color:#fff !important;</attribute>
        </xpath>
        <xpath expr="//form" position="inside">
            <script t-if="dev_error_details" type="text/javascript">
                console.group("%c[CRM Mail Error Diagnostics]", "color: #dc2626; font-weight: bold; font-size: 13px;");
                console.error("Recipient:", "<t t-esc="dev_error_details.get('recipient')"/>");
                console.error("Mail Server:", "<t t-esc="dev_error_details.get('host')"/>:<t t-esc="dev_error_details.get('port')"/> (<t t-esc="dev_error_details.get('encryption')"/>)");
                console.error("SMTP User:", "<t t-esc="dev_error_details.get('user')"/>");
                console.error("Odoo Native Error:", "<t t-esc="dev_error_details.get('odoo_error')"/>");
                console.error("Direct SMTP Error:", "<t t-esc="dev_error_details.get('smtp_error')"/>");
                console.groupEnd();
            </script>
        </xpath>
    </template>

    <!-- Set Password Screen Branding (When opening email link) -->
    <template id="signup_custom" name="CRM Set Password Branding" inherit_id="auth_signup.signup" priority="20">
        <!-- Add YantraConnect CRM Logo & Header -->
        <xpath expr="//form" position="before">
            <div class="text-center" style="padding-top:20px;margin-bottom:20px;">
                <div style="width:60px;height:60px;background:#1a3d6e;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px;">
                    <span style="color:white;font-size:28px;font-weight:800;">Y</span>
                </div>
                <div style="font-size:22px;font-weight:800;color:#1a3d6e;">YantraConnect CRM</div>
                <div style="font-size:12px;color:#64748B;margin-top:4px;">Sales and Lead Management</div>
            </div>
        </xpath>

        <!-- Change 'Sign up' button to 'Reset Password' -->
        <xpath expr="//button[@type='submit']" position="replace">
            <button type="submit" class="btn btn-primary btn-block w-100" style="background:#1a3d6e !important;border-color:#1a3d6e !important;color:#fff !important;padding:10px !important;font-weight:600 !important;font-size:14px !important;border-radius:6px !important;">
                Reset Password
            </button>
        </xpath>

        <!-- Hide 'Already have an account?' link completely and set Username/Email readonly -->
        <xpath expr="//form" position="inside">
            <style>
                .oe_signup_form a,
                form[action*="signup"] a,
                a[href*="/web/login"] {
                    display: none !important;
                }
            </style>
            <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function () {
                    // Rename 'Name' label to 'Username'
                    var labels = document.querySelectorAll("label");
                    for (var i = 0; i &lt; labels.length; i++) {
                        if (labels[i].textContent.trim().toLowerCase() === 'your name' || labels[i].textContent.trim().toLowerCase() === 'name') {
                            labels[i].textContent = "Username";
                        }
                    }
                    // Make Username input readonly
                    var nameInput = document.querySelector("input[name='name']");
                    if (nameInput) {
                        nameInput.readOnly = true;
                        nameInput.style.setProperty("background-color", "#f1f5f9", "important");
                        nameInput.style.setProperty("cursor", "not-allowed", "important");
                        nameInput.style.setProperty("color", "#64748b", "important");
                    }
                    // Make Email input readonly
                    var loginInput = document.querySelector("input[name='login']");
                    if (loginInput) {
                        loginInput.readOnly = true;
                        loginInput.style.setProperty("background-color", "#f1f5f9", "important");
                        loginInput.style.setProperty("cursor", "not-allowed", "important");
                        loginInput.style.setProperty("color", "#64748b", "important");
                    }
                });
            </script>
        </xpath>
    </template>

    <template id="hide_website_nav" inherit_id="website.navbar" priority="99">
        <xpath expr="//nav" position="attributes">
            <attribute name="style">display:none !important;</attribute>
        </xpath>
    </template>

    <!-- Global Custom Favicon & Page Title -->
    <template id="custom_favicon" inherit_id="web.layout" priority="99">
        <xpath expr="//title" position="replace">
            <title>YantraConnect CRM</title>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link rel="shortcut icon" href="/crm_whitelabel/static/src/img/favicon.png" type="image/png"/>
            <link rel="icon" href="/crm_whitelabel/static/src/img/favicon.png" type="image/png"/>
            <link rel="apple-touch-icon" href="/crm_whitelabel/static/src/img/favicon.png"/>
            <link rel="apple-touch-icon" sizes="180x180" href="/crm_whitelabel/static/src/img/favicon.png"/>
        </xpath>
    </template>

</odoo>