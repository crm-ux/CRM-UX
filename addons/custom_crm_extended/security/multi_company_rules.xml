<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 1. Equipment Master Multi-Company Rule -->
        <record id="equipment_master_multi_company_rule" model="ir.rule">
            <field name="name">Equipment Master Multi-Company</field>
            <field name="model_id" ref="model_equipment_master"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- 2. Service Ticket Multi-Company Rule -->
        <record id="service_ticket_multi_company_rule" model="ir.rule">
            <field name="name">Service Ticket Multi-Company</field>
            <field name="model_id" ref="model_service_ticket"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

                <!-- Rename Security Categories on User Form -->
        <!-- 1. "Sales" -> "Lead & Quotation" -->
        <record id="base.module_category_sales_sales" model="ir.module.category">
            <field name="name">Lead &amp; Quotation</field>
        </record>

        <!-- 2. "Products" -> "Product Catalog" -->
        <record id="base.module_category_sales_product" model="ir.module.category">
            <field name="name">Product Catalog</field>
        </record>

        <!-- 3. "Contact" -> "Contact Creation" -->
        <record id="base.module_category_contact" model="ir.module.category">
            <field name="name">Contact Creation</field>
        </record>

        <!-- 4. "Export" -> "Excel Export" -->
        <record id="base.module_category_export" model="ir.module.category">
            <field name="name">Excel Export</field>
        </record>
    </data>
</odoo>
