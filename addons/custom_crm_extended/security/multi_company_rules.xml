<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 1. Equipment Master Multi-Company Rule -->
        <record id="equipment_master_multi_company_rule" model="ir.rule">
            <field name="name">Equipment Master Multi-Company</field>
            <field name="model_id" ref="model_equipment_master"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- 2. Service Ticket Multi-Company Rule -->
        <record id="service_ticket_multi_company_rule" model="ir.rule">
            <field name="name">Service Ticket Multi-Company</field>
            <field name="model_id" ref="model_service_ticket"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Equipment Groups -->
        <record id="group_equipment_own" model="res.groups">
            <field name="name">Equipment: Own Documents Only</field>
        </record>

        <record id="group_equipment_all" model="res.groups">
            <field name="name">Equipment: All Documents</field>
        </record>

        <!-- Rules for the groups -->
        <record id="rule_equipment_own" model="ir.rule">
            <field name="name">Equipment: Own Documents Only</field>
            <field name="model_id" ref="model_equipment_master"/>
            <field name="groups" eval="[(4, ref('group_equipment_own'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        </record>

        <record id="rule_equipment_all" model="ir.rule">
            <field name="name">Equipment: All Documents</field>
            <field name="model_id" ref="model_equipment_master"/>
            <field name="groups" eval="[(4, ref('group_equipment_all'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Global Hierarchy Record Rule for CRM Leads -->
        <record id="rule_crm_lead_hierarchy" model="ir.rule">
            <field name="name">CRM Lead: Hierarchy &amp; Permission Access</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                [(1, '=', 1)] if user.id in (2, 10, 11) or user.perm_lead_quote in ('all', 'admin') else ['|', ('user_id', '=', False), '|', ('user_id', 'in', user._get_accessible_user_ids('perm_lead_quote')), ('create_uid', 'in', user._get_accessible_user_ids('perm_lead_quote'))]
            </field>
        </record>

        <!-- Global Hierarchy Record Rule for Quotations / Sales Orders -->
        <record id="rule_sale_order_hierarchy" model="ir.rule">
            <field name="name">Sale Order: Hierarchy &amp; Permission Access</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                [(1, '=', 1)] if user.id in (2, 10, 11) or user.perm_lead_quote in ('all', 'admin') else ['|', ('user_id', '=', False), '|', ('user_id', 'in', user._get_accessible_user_ids('perm_lead_quote')), ('create_uid', 'in', user._get_accessible_user_ids('perm_lead_quote'))]
            </field>
        </record>

        <!-- Global Hierarchy Record Rule for Service Tickets -->
        <record id="rule_service_ticket_hierarchy" model="ir.rule">
            <field name="name">Service Ticket: Hierarchy &amp; Permission Access</field>
            <field name="model_id" ref="model_service_ticket"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                [(1, '=', 1)] if user.id in (2, 10, 11) or user.perm_service_ticket in ('all', 'admin') else ['|', ('user_id', 'in', user._get_accessible_user_ids('perm_service_ticket')), ('create_uid', 'in', user._get_accessible_user_ids('perm_service_ticket'))]
            </field>
        </record>

        <!-- Global Hierarchy Record Rule for AMC Contracts -->
        <record id="rule_amc_contract_hierarchy" model="ir.rule">
            <field name="name">AMC Contract: Hierarchy &amp; Permission Access</field>
            <field name="model_id" ref="model_amc_contract"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                [(1, '=', 1)] if user.id in (2, 10, 11) or user.perm_amc in ('all', 'admin') else ['|', ('user_id', 'in', user._get_accessible_user_ids('perm_amc')), ('create_uid', 'in', user._get_accessible_user_ids('perm_amc'))]
            </field>
        </record>

        <!-- Global Hierarchy Record Rule for Equipment Master -->
        <record id="rule_equipment_master_hierarchy" model="ir.rule">
            <field name="name">Equipment Master: Hierarchy Access</field>
            <field name="model_id" ref="model_equipment_master"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                [(1, '=', 1)] if user.id in (2, 10, 11) or user.perm_equipment_read else ['|', ('user_id', 'in', user._get_accessible_user_ids('perm_equipment_read')), ('create_uid', 'in', user._get_accessible_user_ids('perm_equipment_read'))]
            </field>
        </record>
    </data>
</odoo>
