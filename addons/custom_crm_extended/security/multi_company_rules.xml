<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 1. Equipment Master Multi-Company Rule -->
        <record id="equipment_master_multi_company_rule" model="ir.rule">
            <field name="name">Equipment Master Multi-Company</field>
            <field name="model_id" ref="model_equipment_master"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- 2. Service Ticket Multi-Company Rule -->
        <record id="service_ticket_multi_company_rule" model="ir.rule">
            <field name="name">Service Ticket Multi-Company</field>
            <field name="model_id" ref="model_service_ticket"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Equipment Groups -->
        <record id="group_equipment_own" model="res.groups">
            <field name="name">Equipment: Own Documents Only</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_equipment_all" model="res.groups">
            <field name="name">Equipment: All Documents</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <!-- Rules for the groups -->
        <record id="rule_equipment_own" model="ir.rule">
            <field name="name">Equipment: Own Documents Only</field>
            <field name="model_id" ref="model_equipment_master"/>
            <field name="groups" eval="[(4, ref('group_equipment_own'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        </record>

        <record id="rule_equipment_all" model="ir.rule">
            <field name="name">Equipment: All Documents</field>
            <field name="model_id" ref="model_equipment_master"/>
            <field name="groups" eval="[(4, ref('group_equipment_all'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
