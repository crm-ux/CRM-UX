<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_extended_location" model="ir.ui.view">
        <field name="name">res.partner.form.extended.location</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Location Details" name="location_details">
                    <group>
                        <group string="Site &amp; Building">
                            <field name="x_site_name" string="Site Name" placeholder="e.g. Ahmedabad Plant"/>
                            <field name="x_building" string="Building" placeholder="e.g. Production Block"/>
                            <field name="x_floor" string="Floor" placeholder="e.g. Ground Floor"/>
                        </group>
                        <group string="Department &amp; Room">
                            <field name="x_department" string="Department" placeholder="e.g. QC Laboratory"/>
                            <field name="x_room_number" string="Room Number" placeholder="e.g. Lab-102"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
