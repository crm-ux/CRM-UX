<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_extended_location" model="ir.ui.view">
        <field name="name">res.partner.form.extended.location</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='function']" position="after">
                <field name="x_site_name" string="Site Name"/>
                <field name="x_building" string="Building"/>
                <field name="x_floor" string="Floor"/>
                <field name="x_department" string="Department"/>
                <field name="x_room_number" string="Room Number"/>
            </xpath>
        </field>
    </record>
</odoo>
