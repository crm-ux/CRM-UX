<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View for Personal To-Do: Standard Non-editable list so clicking New opens Form directly -->
    <record id="view_crm_personal_todo_tree" model="ir.ui.view">
        <field name="name">crm.personal.todo.list</field>
        <field name="model">crm.personal.todo</field>
        <field name="arch" type="xml">
            <list string="My Private To-Do List" default_order="priority desc, target_date asc">
                <field name="priority" widget="priority" nolabel="1"/>
                <field name="name" string="To-Do Item"/>
                <field name="target_date" string="Target Date" decoration-danger="is_overdue"/>
                <field name="reminder_datetime" string="Reminder At" optional="show"/>
                <field name="state" string="Status" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-info="state == 'in_progress'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'complaint'"/>
                <field name="is_overdue" invisible="1"/>
                <field name="user_id" invisible="1"/>
                <button name="action_set_done" type="object" string="Mark Done" icon="fa-check" invisible="state == 'done'" class="text-success"/>
                <button name="action_set_in_progress" type="object" string="In Progress" icon="fa-play" invisible="state in ('in_progress', 'done')" class="text-primary"/>
            </list>
        </field>
    </record>

    <!-- Dedicated Full Form View for Personal To-Do -->
    <record id="view_crm_personal_todo_form" model="ir.ui.view">
        <field name="name">crm.personal.todo.form</field>
        <field name="model">crm.personal.todo</field>
        <field name="arch" type="xml">
            <form string="Personal To-Do" class="crm-personal-todo-form">
                <header class="o_form_statusbar">
                    <button name="action_set_done" type="object" string="Mark as Done" class="btn-success" icon="fa-check" invisible="state == 'done'"/>
                    <button name="action_set_in_progress" type="object" string="Start Work" class="btn-primary" icon="fa-play" invisible="state == 'in_progress'"/>
                    <button name="action_set_complaint" type="object" string="Report Issue / Hold" class="btn-danger" icon="fa-exclamation-triangle" invisible="state == 'complaint'"/>
                    <button name="action_set_pending" type="object" string="Reset to Pending" class="btn-secondary" icon="fa-undo" invisible="state == 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,done,complaint"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="To-Do Title" class="oe_edit_only" style="font-weight: 700; color: #0b3d91; font-size: 14px;"/>
                        <h1>
                            <field name="name" placeholder="e.g. Call Client regarding installation readiness..." style="font-weight: 700;"/>
                        </h1>
                    </div>
                    <div class="alert alert-danger mt-2" role="alert" invisible="state != 'complaint'">
                        <strong><i class="fa fa-exclamation-triangle me-1"></i> Issue / Hold Details:</strong>
                        <field name="issue_reason" placeholder="Describe what issue or blocker you are facing with this To-Do..."/>
                    </div>
                    <group>
                        <group string="Schedule &amp; Priority">
                            <field name="target_date" string="Target Date"/>
                            <field name="reminder_datetime" string="Reminder Date &amp; Time" widget="datetime" options="{'step': 1}"/>
                            <field name="priority" widget="priority" string="Priority"/>
                        </group>
                        <group string="Ownership &amp; Status">
                            <field name="user_id" readonly="1" options="{'no_open': True}" string="Owner (Private)"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Personal Notes / Checklist" icon="fa-pencil-square-o">
                            <field name="notes" placeholder="Write step-by-step checklist items, reminders, or private notes here..." style="min-height: 120px;"/>
                        </page>
                        <page string="Attachments &amp; Files" icon="fa-paperclip">
                            <field name="todo_attachment_ids" nolabel="1">
                                <list editable="bottom" string="Attachments">
                                    <field name="name" string="File Name"/>
                                    <field name="file" filename="name" widget="binary" string="File" options="{'no_clear': True}"/>
                                    <button name="action_preview_file" 
                                            type="object" 
                                            icon="fa-eye" 
                                            title="Preview" 
                                            invisible="not file"
                                            class="btn btn-sm btn-link text-primary p-0 ms-2" 
                                            style="font-size: 1.15rem; color: #0b3d91 !important;"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for Personal To-Do (Enables Native Odoo Search Bar) -->
    <record id="view_crm_personal_todo_search" model="ir.ui.view">
        <field name="name">crm.personal.todo.search</field>
        <field name="model">crm.personal.todo</field>
        <field name="arch" type="xml">
            <search string="Personal To-Do">
                <field name="name"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action Window for Personal To-Do -->
    <record id="action_crm_personal_todo" model="ir.actions.act_window">
        <field name="name">My To-Do List</field>
        <field name="res_model">crm.personal.todo</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crm_personal_todo_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tasks yet
            </p>
            <p>
                Keep track of your personal notes, reminders, and daily checklist here.
            </p>
        </field>
    </record>

    <!-- Scheduled Action / Cron for To-Do Reminders -->
    <record id="ir_cron_crm_personal_todo_reminder" model="ir.cron">
        <field name="name">Personal To-Do: Process Due Reminders</field>
        <field name="model_id" ref="model_crm_personal_todo"/>
        <field name="state">code</field>
        <field name="code">model.check_todo_reminders_cron()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
