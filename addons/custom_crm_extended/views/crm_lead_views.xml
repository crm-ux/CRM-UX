<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Priority: remove star widget → normal dropdown (Low / Medium / High) -->
    <record id="crm_lead_form_priority_dropdown" model="ir.ui.view">
        <field name="name">crm.lead.form.priority.dropdown</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='priority']" position="replace">
                <field name="priority" widget="selection"/>
            </xpath>
        </field>
    </record>

    <!-- Manual stage transition buttons -->
    <record id="crm_lead_form_stage_buttons" model="ir.ui.view">
        <field name="name">crm.lead.form.stage.buttons</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="before">
                <button name="action_move_to_contacted" string="Contacted" type="object"
                    invisible="x_stage_sequence != 0 or not active"/>
                <button name="action_move_to_technical_discussion" string="Technical Discussion" type="object"
                    invisible="x_stage_sequence != 5 or not active"/>
                <button name="action_move_to_qualified" string="Qualified" type="object"
                    invisible="x_stage_sequence != 7 or not active"/>
                <button name="action_move_to_opportunity" string="Opportunity" type="object"
                    invisible="x_stage_sequence != 10 or not active"/>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="x_stage_sequence" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- New button on form → Lead Creation wizard -->
    <record id="crm_lead_form_wizard_create" model="ir.ui.view">
        <field name="name">crm.lead.form.wizard.create</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="js_class">crm_lead_form</attribute>
            </xpath>
        </field>
    </record>
    
    <!-- Stage Filters & Grouping for Pipeline Search View -->
    <record id="crm_lead_view_search_inherit_stages" model="ir.ui.view">
        <field name="name">crm.lead.search.inherit.stages</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter string="Stage" name="group_by_stage" context="{'group_by': 'stage_id'}"/>
            </xpath>
            <xpath expr="//filter[@name='assigned_to_me']" position="before">
                <filter string="Lead" name="filter_stage_lead" domain="[('x_stage_sequence', '=', 0)]"/>
                <filter string="Contacted" name="filter_stage_contacted" domain="[('x_stage_sequence', '=', 5)]"/>
                <filter string="Tech. Discussion" name="filter_stage_tech" domain="[('x_stage_sequence', '=', 7)]"/>
                <filter string="Qualified" name="filter_stage_qualified" domain="[('x_stage_sequence', '=', 10)]"/>
                <filter string="Opportunity" name="filter_stage_opp" domain="[('x_stage_sequence', '=', 20)]"/>
                <filter string="Quotes" name="filter_stage_quotes" domain="[('x_stage_sequence', '=', 30)]"/>
                <filter string="Sent" name="filter_stage_sent" domain="[('x_stage_sequence', '=', 35)]"/>
                <filter string="Negotiation" name="filter_stage_neg" domain="[('x_stage_sequence', '=', 40)]"/>
                <filter string="Order Expected" name="filter_stage_orderexp" domain="[('x_stage_sequence', '=', 50)]"/>
                <filter string="Won" name="filter_stage_won" domain="[('x_stage_sequence', '=', 90)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- Hide stock Odoo "New Quotation" button - use our own Create Quotation flow instead -->
    <record id="crm_lead_hide_stock_new_quotation" model="ir.ui.view">
        <field name="name">crm.lead.hide.stock.new.quotation</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>