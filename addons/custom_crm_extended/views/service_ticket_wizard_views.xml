<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_ticket_wizard_form" model="ir.ui.view">
        <field name="name">service.ticket.wizard.form</field>
        <field name="model">service.ticket.wizard</field>
        <field name="arch" type="xml">
            <form string="Service Ticket Creation">
                <field name="step" invisible="1"/>
                <sheet>
                    <!-- Step indicators matching Equipment Master Wizard -->
                    <div style="padding:8px 0 16px 0;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                        <button name="action_goto_1" type="object" class="btn step_current" invisible="step != 1">1. Equipment Info</button>
                        <button name="action_goto_1" type="object" class="btn step_done" invisible="step &lt;= 1">1. Equipment Info</button>
                        <button name="action_goto_1" type="object" class="btn step_future" invisible="step &gt;= 1">1. Equipment Info</button>
                        <span>&#8594;</span>
                        <button name="action_goto_2" type="object" class="btn step_current" invisible="step != 2">2. Complaint</button>
                        <button name="action_goto_2" type="object" class="btn step_done" invisible="step &lt;= 2">2. Complaint</button>
                        <button name="action_goto_2" type="object" class="btn step_future" invisible="step &gt;= 2">2. Complaint</button>
                        <span>&#8594;</span>
                        <button name="action_goto_3" type="object" class="btn step_current" invisible="step != 3">3. Assignment</button>
                        <button name="action_goto_3" type="object" class="btn step_done" invisible="step &lt;= 3">3. Assignment</button>
                        <button name="action_goto_3" type="object" class="btn step_future" invisible="step &gt;= 3">3. Assignment</button>
                        <span>&#8594;</span>
                        <button name="action_goto_4" type="object" class="btn step_current" invisible="step != 4">4. Resolution</button>
                        <button name="action_goto_4" type="object" class="btn step_done" invisible="step &lt;= 4">4. Resolution</button>
                        <button name="action_goto_4" type="object" class="btn step_future" invisible="step &gt;= 4">4. Resolution</button>
                    </div>

                    <!-- STEP 1: Equipment Info & Customer Info -->
                    <div invisible="step != 1">
                        <!-- Section 1: Ticket & Customer Information -->
                        <div style="font-size:14px;font-weight:700;color:#000000;border-bottom:2px solid #0b3d91;padding-bottom:4px;margin-bottom:16px;">Ticket &amp; Customer Information</div>
                        <group>
                            <field name="ticket_id" string="Ticket ID" placeholder="e.g. TST2024-001"/>
                            <field name="partner_id" string="Customer Name" placeholder="Select Customer..."/>
                            <field name="equipment_id" string="Equipment" placeholder="Select Equipment"/>
                        </group>
                        <group>
                            <field name="site_name" string="Site Name" placeholder="e.g. Plant / Hospital"/>
                            <field name="contact_person" string="Contact Person" placeholder="e.g. Responsible person"/>
                        </group>
                        <group>
                            <field name="contact_number" string="Contact Number" placeholder="e.g. Phone number"/>
                            <field name="email" string="Customer Email" placeholder="e.g. customer@email.com"/>
                        </group>
                        <group>
                            <field name="ticket_datetime" string="Ticket Date &amp; Time"/>
                        </group>

                        <!-- Section 2: Equipment Specifications (Below Section 1) -->
                        <div style="font-size:14px;font-weight:700;color:#000000;border-bottom:2px solid #0b3d91;padding-bottom:4px;margin-top:20px;margin-bottom:16px;">Equipment Specifications</div>
                        <group>
                            <field name="model_number" string="Model Number" placeholder="e.g. TSV336RLGF"/>
                            <field name="serial_number" string="Serial Number" placeholder="e.g. 336RLGF12345"/>
                        </group>
                        <group>
                            <field name="part_number" string="Part Number" placeholder="e.g. TSV336RLGF"/>
                        </group>
                    </div>

                    <!-- STEP 2: Complaint Details -->
                    <div invisible="step != 2">
                        <div style="font-size:14px;font-weight:700;color:#000000;border-bottom:2px solid #0b3d91;padding-bottom:4px;margin-bottom:16px;">Complaint Details</div>
                        <group>
                            <field name="complaint_type" string="Complaint Type" widget="radio" options="{'horizontal': true}" class="custom_radio_clean"/>
                            <field name="priority" string="Priority" widget="radio" options="{'horizontal': true}" class="custom_radio_clean"/>
                        </group>
                        <group>
                            <field name="complaint_description" string="Complaint Description" placeholder="Describe the problem reported by the customer..." />
                        </group>
                    </div>

                    <!-- STEP 3: Assignment & Schedule -->
                    <div invisible="step != 3">
                        <div style="font-size:14px;font-weight:700;color:#000000;border-bottom:2px solid #0b3d91;padding-bottom:4px;margin-bottom:16px;">Engineer Assignment &amp; Schedule</div>
                        <group>
                            <field name="engineer_id" string="Assigned Engineer" placeholder="Select Field Engineer..."/>
                            <field name="engineer_contact" string="Engineer Contact" placeholder="Phone number"/>
                        </group>
                        <group>
                            <field name="engineer_email" string="Engineer Email" placeholder="Email address"/>
                            <field name="visit_date" string="Visit Date"/>
                        </group>
                        <group>
                            <field name="ticket_status" string="Ticket Status" widget="radio" options="{'horizontal': true}" class="custom_radio_clean"/>
                        </group>
                    </div>

                    <!-- STEP 4: Resolution & Sign-off -->
                    <div invisible="step != 4">
                        <div style="font-size:14px;font-weight:700;color:#000000;border-bottom:2px solid #0b3d91;padding-bottom:4px;margin-bottom:16px;">Action Taken</div>
                        <group>
                            <field name="root_cause" string="Root Cause" placeholder="e.g. Compressor failure" />
                            <field name="corrective_action" string="Corrective Action" placeholder="e.g. Compressor replaced" />
                            <field name="spare_parts_used" string="Spare Parts Used" placeholder="e.g. Compressor Kit"/>
                        </group>

                        <div style="font-size:14px;font-weight:700;color:#000000;border-bottom:2px solid #0b3d91;padding-bottom:4px;margin-top:20px;margin-bottom:16px;">Timings</div>
                        <group>
                            <field name="service_start_time" string="Service Start Time"/>
                            <field name="service_end_time" string="Service End Time"/>
                        </group>
                        <!-- <group>
                            <field name="customer_signature" string="Customer Signature" widget="image"/>
                            <field name="engineer_signature" string="Engineer Signature" widget="image"/>
                        </group> -->
                    </div>
                </sheet>

                <!-- Footer Navigation -->
                <footer>
                    <button string="Back" type="object" name="action_prev_step" class="btn btn-secondary" invisible="step == 1"/>
                    <button string="Next" type="object" name="action_next_step" class="btn btn-primary" invisible="step == 4"/>
                    <button string="Create Ticket" type="object" name="action_save_ticket" class="btn btn-primary" invisible="step != 4"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_service_ticket_wizard" model="ir.actions.act_window">
        <field name="name">Create Service Ticket</field>
        <field name="res_model">service.ticket.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_step': 1}</field>
    </record>
</odoo>
