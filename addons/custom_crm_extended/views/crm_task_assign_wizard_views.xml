<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_task_assign_wizard_form" model="ir.ui.view">
        <field name="name">crm.task.assign.wizard.form</field>
        <field name="model">crm.task.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Work">
                <sheet>
                    <group>
                        <field name="assigned_to_id" string="Assign To" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                    </group>
                    <group>
                        <group>
                            <field name="name" string="Task Title" placeholder="e.g. Inspect Boiler Unit 3"/>
                        </group>
                        <group>
                            <field name="date_deadline" string="Deadline"/>
                        </group>
                    </group>
                    <group string="Work Details / Instructions">
                        <field name="instructions" nolabel="1" placeholder="Add instructions or requirements for this task..."/>
                    </group>
                    <group string="Attachment">
                        <field name="attachment_name" invisible="1"/>
                        <field name="attachment_file" filename="attachment_name" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_assign_work" string="Assign Work" type="object" class="btn btn-primary" style="background:#0b3d91; border-color:#0b3d91;"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_task_assign_wizard" model="ir.actions.act_window">
        <field name="name">Assign Work</field>
        <field name="res_model">crm.task.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
