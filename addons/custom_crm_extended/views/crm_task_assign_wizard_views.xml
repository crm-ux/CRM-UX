<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_task_assign_wizard_form" model="ir.ui.view">
        <field name="name">crm.task.assign.wizard.form</field>
        <field name="model">crm.task.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Work">
                <sheet>
                    <!-- Section 1: Member Assignment -->
                    <div style="font-size:14px;font-weight:700;color:#0b3d91;border-bottom:2px solid #0b3d91;padding-bottom:4px;margin-bottom:14px;display:flex;align-items:center;gap:6px;">
                        <span>Assign Team Member</span>
                    </div>
                    <group>
                        <field name="assigned_to_id" string="Assign To" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}" placeholder="Select team member..."/>
                    </group>

                    <!-- Section 2: Task Information -->
                    <div style="font-size:14px;font-weight:700;color:#0b3d91;border-bottom:2px solid #0b3d91;padding-bottom:4px;margin-top:16px;margin-bottom:14px;">
                        <span>Task Information</span>
                    </div>
                    <group>
                        <group>
                            <field name="name" string="Task Title" placeholder="e.g. Inspect Boiler Unit 3"/>
                        </group>
                        <group>
                            <field name="date_deadline" string="Deadline"/>
                        </group>
                    </group>

                    <!-- Section 3: Work Details / Instructions -->
                    <div style="font-size:14px;font-weight:700;color:#0b3d91;border-bottom:2px solid #0b3d91;padding-bottom:4px;margin-top:16px;margin-bottom:14px;">
                        <span>Work Details / Instructions</span>
                    </div>
                    <div style="margin-bottom: 12px;">
                        <field name="instructions" nolabel="1" placeholder="Add instructions or requirements for this task..." style="min-height: 85px; width: 100%; border-radius: 6px;"/>
                    </div>

                    <!-- Section 4: Attachment -->
                    <div style="font-size:14px;font-weight:700;color:#0b3d91;border-bottom:2px solid #0b3d91;padding-bottom:4px;margin-top:16px;margin-bottom:14px;">
                        <span>Attachment</span>
                    </div>
                    <group>
                        <field name="attachment_name" invisible="1"/>
                        <field name="attachment_file" filename="attachment_name" string="Upload File" widget="binary"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_assign_work" string="Assign Work" type="object" class="btn btn-primary" style="background:#0b3d91; border-color:#0b3d91; font-weight:600; padding:6px 18px;"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel" style="padding:6px 16px;"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_task_assign_wizard" model="ir.actions.act_window">
        <field name="name">Assign Work</field>
        <field name="res_model">crm.task.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
