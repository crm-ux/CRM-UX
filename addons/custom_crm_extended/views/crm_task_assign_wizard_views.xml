<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_task_assign_wizard_form" model="ir.ui.view">
        <field name="name">crm.task.assign.wizard.form</field>
        <field name="model">crm.task.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Work" class="crm-assign-work-wizard-form">
                <sheet>
                    <!-- Section 1: Member Assignment -->
                    <div class="crm-wizard-group">
                        <label for="assigned_to_id" string="Assign To" class="crm-wizard-label"/>
                        <field name="assigned_to_id" 
                               string="Assign To" 
                               nolabel="1"
                               required="1"
                               context="{'show_rich_user_name': True}"
                               options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}" 
                               placeholder="Select team member..."/>
                    </div>

                    <!-- Section 2: Task Information & Schedule -->
                    <div class="crm-wizard-grid-2">
                        <div>
                            <label for="name" string="Task Title" class="crm-wizard-label"/>
                            <field name="name" 
                                   string="Task Title"
                                   nolabel="1" 
                                   required="1"
                                   placeholder="e.g. Inspect Boiler Unit 3"/>
                        </div>
                        <div>
                            <label for="date_deadline" string="Deadline" class="crm-wizard-label"/>
                            <field name="date_deadline" 
                                   string="Deadline"
                                   required="is_recurring"
                                   nolabel="1"/>
                        </div>
                    </div>

                    <!-- Section 2.5: Company & Link to Record (Optional) -->
                    <div class="crm-wizard-grid-2-equal">
                        <div>
                            <label for="company_id" string="Company (Optional)" class="crm-wizard-label"/>
                            <field name="company_id" nolabel="1" options="{'no_create': True, 'no_open': True}" placeholder="Leave empty for all companies..."/>
                        </div>
                        <div>
                            <label for="related_model" string="Related Entity (Optional)" class="crm-wizard-label"/>
                            <field name="related_model" nolabel="1" placeholder="Link to Lead, Quote, Equipment..."/>
                        </div>
                    </div>

                    <!-- Dynamic Linked Record Pickers -->
                    <div class="crm-wizard-group" invisible="not related_model">
                        <span class="o_form_label crm-wizard-label">Select Record</span>
                        <field name="lead_id" invisible="related_model != 'crm.lead'" nolabel="1" options="{'no_create': True}" placeholder="Search &amp; select Lead..."/>
                        <field name="order_id" invisible="related_model != 'sale.order'" nolabel="1" options="{'no_create': True}" placeholder="Search &amp; select Quotation..."/>
                        <field name="partner_id" invisible="related_model != 'res.partner'" nolabel="1" options="{'no_create': True}" placeholder="Search &amp; select Customer..."/>
                        <field name="equipment_id" invisible="related_model != 'equipment.master'" nolabel="1" options="{'no_create': True}" placeholder="Search &amp; select Equipment..."/>
                        <field name="ticket_id" invisible="related_model != 'service.ticket'" nolabel="1" options="{'no_create': True}" placeholder="Search &amp; select Ticket..."/>
                        <field name="amc_id" invisible="related_model != 'amc.contract'" nolabel="1" options="{'no_create': True}" placeholder="Search &amp; select AMC Contract..."/>
                    </div>

                    <!-- Recurring Options -->
                    <div class="crm-wizard-group">
                        <div class="crm-wizard-checkbox-row">
                            <field name="is_recurring" nolabel="1"/>
                            <label for="is_recurring" string="Repeat this Task Automatically (Recurring)" class="crm-wizard-label"/>
                        </div>
                        <div class="mt-2" invisible="not is_recurring">
                            <label for="recurrence_period" string="Repeat Cycle" class="crm-wizard-label"/>
                            <field name="recurrence_period" nolabel="1"/>
                        </div>
                    </div>

                    <!-- Section 3: Work Details / Instructions -->
                    <div class="crm-wizard-group">
                        <label for="instructions" string="Work Details / Instructions" class="crm-wizard-label"/>
                        <field name="instructions" 
                               nolabel="1" 
                               placeholder="Add instructions or requirements for this task..."/>
                    </div>

                    <!-- Section 4: Attachments (Multiple Files) -->
                    <div class="crm-wizard-group crm-wizard-attachment-group">
                        <label for="wizard_attachment_ids" class="crm-wizard-label mb-2">
                            Attachments 
                        </label>
                        <field name="wizard_attachment_ids" nolabel="1">
                            <list editable="bottom" string="Attachments">
                                <field name="name" string="File Name"/>
                                <field name="file" filename="name" widget="binary" string="File" options="{'no_clear': True}"/>
                            </list>
                        </field>
                    </div>
                </sheet>
                <footer>
                    <button name="action_assign_work" string="Assign Work" type="object" class="btn btn-primary" style="background: #0b3d91; border-color: #0b3d91; font-weight: 600; padding: 0.5rem 1.4rem; border-radius: 6px; box-shadow: 0 2px 4px rgba(11,61,145,0.25);"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel" style="padding: 0.5rem 1.1rem; border-radius: 6px; border: 1px solid #cbd5e1; background: #ffffff; color: #475569; font-weight: 600;"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_task_assign_wizard" model="ir.actions.act_window">
        <field name="name">Assign Work</field>
        <field name="res_model">crm.task.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
