<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_task_assign_wizard_form" model="ir.ui.view">
        <field name="name">crm.task.assign.wizard.form</field>
        <field name="model">crm.task.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Work" class="crm-assign-work-wizard-form">
                <sheet>
                    <!-- Section 1: Member Assignment -->
                    <div class="crm-wizard-group">
                        <label for="assigned_to_id" string="Assign To" class="crm-wizard-label"/>
                        <field name="assigned_to_id" 
                               string="Assign To" 
                               nolabel="1"
                               required="1"
                               options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}" 
                               placeholder="Select team member..."/>
                    </div>

                    <!-- Section 2: Task Information (Grid) -->
                    <div class="crm-wizard-grid-2">
                        <div>
                            <label for="name" string="Task Title" class="crm-wizard-label"/>
                            <field name="name" 
                                   string="Task Title"
                                   nolabel="1" 
                                   required="1"
                                   placeholder="e.g. Inspect Boiler Unit 3"/>
                        </div>
                        <div>
                            <label for="date_deadline" string="Deadline" class="crm-wizard-label"/>
                            <field name="date_deadline" 
                                   string="Deadline"
                                   nolabel="1"/>
                        </div>
                    </div>

                    <!-- Section 3: Work Details / Instructions -->
                    <div class="crm-wizard-group">
                        <label for="instructions" string="Work Details / Instructions" class="crm-wizard-label"/>
                        <field name="instructions" 
                               nolabel="1" 
                               placeholder="Add instructions or requirements for this task..."/>
                    </div>

                    <!-- Section 4: Attachment -->
                    <div class="crm-wizard-group crm-wizard-attachment-group">
                        <label for="attachment_file" class="crm-wizard-label">
                            Attachment <small style="color: #64748b; font-weight: 500;">(Drawings, PO, Photos, PDF up to 20MB)</small>
                        </label>
                        <div class="crm-wizard-dropzone">
                            <field name="attachment_name" invisible="1"/>
                            <field name="attachment_file" filename="attachment_name" nolabel="1" widget="binary"/>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_assign_work" string="Assign Work" type="object" class="btn btn-primary" style="background: #0b3d91; border-color: #0b3d91; font-weight: 600; padding: 0.5rem 1.4rem; border-radius: 6px; box-shadow: 0 2px 4px rgba(11,61,145,0.25);"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel" style="padding: 0.5rem 1.1rem; border-radius: 6px; border: 1px solid #cbd5e1; background: #ffffff; color: #475569; font-weight: 600;"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_task_assign_wizard" model="ir.actions.act_window">
        <field name="name">Assign Work</field>
        <field name="res_model">crm.task.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
