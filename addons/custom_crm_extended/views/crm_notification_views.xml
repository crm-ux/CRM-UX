<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Notification Master List / Tree View -->
    <record id="view_crm_notification_tree" model="ir.ui.view">
        <field name="name">crm.notification.list</field>
        <field name="model">crm.notification</field>
        <field name="arch" type="xml">
            <list string="Notification Master" decoration-bf="state == 'unread'" create="0" delete="1">
                <header>
                    <button name="action_mark_all_read" string="Mark All as Read" type="object" class="btn btn-secondary"/>
                </header>
                <field name="state" widget="badge" 
                       decoration-primary="state == 'unread'" 
                       decoration-muted="state == 'read'"/>
                <field name="date" string="Date &amp; Time"/>
                <field name="category" widget="badge" 
                       decoration-info="category == 'voucher'" 
                       decoration-warning="category == 'ticket'" 
                       decoration-success="category == 'lead'" 
                       decoration-primary="category == 'task'"/>
                <field name="name" string="Title"/>
                <field name="sender_id" string="Sent By" widget="many2one_avatar_user" options="{'no_open': True}"/>
                <field name="record_ref_name" string="Target Record"/>
                <field name="summary" string="Details" optional="show"/>
                <button name="action_open_target_record" type="object" icon="fa-external-link text-primary" title="Open Record" invisible="not res_id"/>
                <button name="action_mark_as_read" type="object" icon="fa-check text-success" title="Mark as Read" invisible="state == 'read'"/>
                <button name="action_mark_as_unread" type="object" icon="fa-undo text-muted" title="Mark as Unread" invisible="state == 'unread'"/>
            </list>
        </field>
    </record>

    <!-- Notification Master Form View -->
    <record id="view_crm_notification_form" model="ir.ui.view">
        <field name="name">crm.notification.form</field>
        <field name="model">crm.notification</field>
        <field name="arch" type="xml">
            <form string="Notification Details" create="0">
                <header>
                    <button name="action_open_target_record" string="Open Record" type="object" class="btn btn-primary" invisible="not res_id"/>
                    <button name="action_mark_as_read" string="Mark as Read" type="object" class="btn btn-secondary" invisible="state == 'read'"/>
                    <button name="action_mark_as_unread" string="Mark as Unread" type="object" class="btn btn-secondary" invisible="state == 'unread'"/>
                    <field name="state" widget="statusbar" statusbar_visible="unread,read"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Notification Title"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Overview">
                            <field name="category" widget="badge" readonly="1" 
                                   decoration-info="category == 'voucher'" 
                                   decoration-warning="category == 'ticket'" 
                                   decoration-success="category == 'lead'" 
                                   decoration-primary="category == 'task'"/>
                            <field name="date" readonly="1"/>
                            <field name="sender_id" readonly="1" widget="many2one_avatar_user" options="{'no_open': True}"/>
                        </group>
                        <group string="Target Record">
                            <field name="record_ref_name" readonly="1"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Message &amp; Details">
                        <field name="summary" readonly="1" nolabel="1" placeholder="No details provided."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Notification Master Search View -->
    <record id="view_crm_notification_search" model="ir.ui.view">
        <field name="name">crm.notification.search</field>
        <field name="model">crm.notification</field>
        <field name="arch" type="xml">
            <search string="Search Notifications">
                <field name="name" string="Title"/>
                <field name="record_ref_name" string="Target Record"/>
                <field name="sender_id" string="Sent By"/>
                
                <separator/>
                <filter string="Unread" name="filter_unread" domain="[('state', '=', 'unread')]"/>
                <filter string="Read" name="filter_read" domain="[('state', '=', 'read')]"/>
                
                <separator/>
                <filter string="Expense Vouchers" name="filter_voucher" domain="[('category', '=', 'voucher')]"/>
                <filter string="Service Tickets" name="filter_ticket" domain="[('category', '=', 'ticket')]"/>
                <filter string="CRM Leads" name="filter_lead" domain="[('category', '=', 'lead')]"/>
                <filter string="Tasks" name="filter_task" domain="[('category', '=', 'task')]"/>

                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Sent By" name="group_sender" context="{'group_by': 'sender_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action for Notification Master -->
    <record id="action_crm_notification" model="ir.actions.act_window">
        <field name="name">Notification Master</field>
        <field name="res_model">crm.notification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crm_notification_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No notifications yet!
            </p>
            <p>
                All your system alerts, voucher approvals, ticket assignments, leads, and task updates will be stored here with complete privacy.
            </p>
        </field>
    </record>

    <!-- Top Menu Item for Notification Master -->
    <menuitem id="menu_crm_notification_root" 
              name="Notification Master" 
              action="action_crm_notification" 
              sequence="30"/>
</odoo>

