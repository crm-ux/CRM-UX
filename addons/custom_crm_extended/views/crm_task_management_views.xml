<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compact Quick-Create Popup View (Google Calendar Style: 3 Essential Fields) -->
    <record id="view_crm_task_management_quick_form" model="ir.ui.view">
        <field name="name">crm.task.management.quick.form</field>
        <field name="model">crm.task.management</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Task Quick Details" class="crm-task-management-form">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Task Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Follow up on Quote or Inspect Boiler..." required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="assigned_to_id" string="Assign To" required="1" context="{'show_rich_user_name': True}" options="{'no_open': True, 'no_create': True}"/>
                            <field name="date_deadline" string="Deadline" required="1"/>
                        </group>
                        <group>
                            <field name="state" string="Status"/>
                            <field name="related_record_display" string="Linked Record" invisible="not related_record_display" readonly="1"/>
                        </group>
                    </group>
                    <div class="mt-2 text-muted" style="font-size: 0.88rem;">
                        <i class="fa fa-info-circle text-primary me-1"/> Click <b>Edit / More Options</b> below to link Leads, Quotations, Equipment, add attachments, or set recurring schedule.
                    </div>
                </sheet>
                <footer>
                    <button string="Save" type="object" class="btn btn-primary" special="save"/>
                    <button name="action_open_full_detail_form" string="Edit / More Options" type="object" class="btn btn-secondary ms-2" icon="fa-pencil-square-o"/>
                    <button string="Discard" class="btn btn-link text-muted ms-auto" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Google Calendar View (Primary View) -->
    <record id="view_crm_task_management_calendar" model="ir.ui.view">
        <field name="name">crm.task.management.calendar</field>
        <field name="model">crm.task.management</field>
        <field name="arch" type="xml">
            <calendar string="Task Calendar" 
                      date_start="date_deadline" 
                      color="assigned_to_id" 
                      mode="month"
                      form_view_id="%(view_crm_task_management_quick_form)d"
                      event_open_popup="true">
                <field name="name"/>
                <field name="assigned_to_id" avatar_field="avatar_128" write_model="res.users" write_field="partner_id"/>
                <field name="assigned_by_id"/>
                <field name="state" filters="1"/>
                <field name="related_record_display"/>
            </calendar>
        </field>
    </record>

    <!-- List / Tree View -->
    <record id="view_crm_task_management_tree" model="ir.ui.view">
        <field name="name">crm.task.management.list</field>
        <field name="model">crm.task.management</field>
        <field name="arch" type="xml">
            <list string="Task Management" default_order="date_deadline asc, date_assigned desc">
                <field name="name" string="Task"/>
                <field name="assigned_to_id" string="Assigned To"/>
                <field name="assigned_by_id" string="Assigned By"/>
                <field name="date_deadline" string="Deadline"/>
                <field name="related_model" string="Entity Type" optional="show"/>
                <field name="related_record_display" string="Linked Record" optional="show"/>
                <field name="company_id" string="Company" optional="hide"/>
                <field name="state" string="Status" widget="badge" 
                       decoration-warning="state == 'pending'" 
                       decoration-info="state == 'in_progress'" 
                       decoration-success="state == 'done'" 
                       decoration-danger="state == 'complaint'"/>
                <field name="is_recurring" string="Recurring" optional="hide"/>
                <field name="is_unlocked" string="Active" optional="hide"/>
                <field name="completion_remarks" string="Work Remarks" optional="show"/>
                <field name="complaint_notes" string="Issue Faced" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_crm_task_management_form" model="ir.ui.view">
        <field name="name">crm.task.management.form</field>
        <field name="model">crm.task.management</field>
        <field name="arch" type="xml">
            <form string="Task Management" class="crm-task-management-form" js_class="crm_task_management_form">
                <header>
                    <button name="action_open_related_record" 
                            type="object" 
                            string="Open Linked Record" 
                            class="btn-primary" 
                            icon="fa-external-link"
                            invisible="not related_model or not related_res_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,done,complaint"/>
                </header>
                <sheet>
                    <field name="can_edit_manager_fields" invisible="1"/>
                    <field name="related_res_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Task"/>
                        <h1>
                            <field name="name" placeholder="e.g. Inspect Boiler Unit 3" readonly="not can_edit_manager_fields"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Assignment &amp; Schedule">
                            <field name="assigned_by_id" string="Assigned By" readonly="1" options="{'no_open': True}"/>
                            <field name="assigned_to_id" string="Assigned Employee" readonly="not can_edit_manager_fields" context="{'show_rich_user_name': True}" options="{'no_open': True, 'no_create': True}"/>
                            <field name="date_assigned" readonly="1"/>
                            <field name="date_deadline" readonly="not can_edit_manager_fields"/>
                            <field name="company_id" options="{'no_create': True}" placeholder="All Companies" readonly="not can_edit_manager_fields"/>
                        </group>
                        <group string="Linked Entity &amp; Recurrence">
                            <field name="related_model" string="Related Entity" readonly="not can_edit_manager_fields"/>
                            <field name="lead_id" invisible="related_model != 'crm.lead'" readonly="not can_edit_manager_fields" options="{'no_create': True}"/>
                            <field name="order_id" invisible="related_model != 'sale.order'" readonly="not can_edit_manager_fields" options="{'no_create': True}"/>
                            <field name="partner_id" invisible="related_model != 'res.partner'" readonly="not can_edit_manager_fields" options="{'no_create': True}"/>
                            <field name="equipment_id" invisible="related_model != 'equipment.master'" readonly="not can_edit_manager_fields" options="{'no_create': True}"/>
                            <field name="ticket_id" invisible="related_model != 'service.ticket'" readonly="not can_edit_manager_fields" options="{'no_create': True}"/>
                            <field name="amc_id" invisible="related_model != 'amc.contract'" readonly="not can_edit_manager_fields" options="{'no_create': True}"/>
                            
                            <field name="is_recurring" string="Repeat Task" readonly="not can_edit_manager_fields"/>
                            <field name="recurrence_period" invisible="not is_recurring" readonly="not can_edit_manager_fields"/>
                            <field name="recurrence_end_date" invisible="not is_recurring" readonly="not can_edit_manager_fields"/>
                        </group>
                    </group>

                    <group string="Attachments &amp; Files">
                        <label for="attachment_file" string="Attachment (Drawings, PO, PDF)"/>
                        <div class="d-flex align-items-center w-100 crm_task_attachment_box crm_invoice_field_box">
                            <field name="attachment_name" invisible="1"/>
                            <field name="attachment_file" filename="attachment_name" readonly="not can_edit_manager_fields" class="m-0 p-0 flex-grow-1"/>
                            <button name="action_preview_task_attachment" 
                                    type="object" 
                                    icon="fa-eye" 
                                    title="Preview Attachment" 
                                    invisible="not attachment_file" 
                                    class="btn btn-sm btn-link text-primary p-0 ms-1" 
                                    style="font-size: 1.15rem; color: #0b3d91 !important;"/>
                        </div>
                    </group>

                    <notebook>
                        <page string="Instructions / Work Details">
                            <field name="instructions" placeholder="Detailed instructions from assigner..." readonly="not can_edit_manager_fields"/>
                        </page>
                        <page string="Employee Action &amp; Reporting">
                            <group class="crm-single-line-group" style="max-width: 900px;">
                                <field name="state" string="Task Status"/>
                                <field name="completion_remarks" placeholder="Enter work completion remarks..."/>
                                <field name="complaint_notes" placeholder="Report any issue, bottleneck, or complaint faced..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action Window: Primary view is Calendar, followed by List and Form -->
    <record id="action_crm_task_management" model="ir.actions.act_window">
        <field name="name">Task Management</field>
        <field name="res_model">crm.task.management</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
</odoo>
