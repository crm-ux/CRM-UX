<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_custom_settings_form" model="ir.ui.view">
        <field name="name">crm.custom.settings.form</field>
        <field name="model">crm.custom.settings</field>
        <field name="arch" type="xml">
            <form string="CRM Settings" create="0" delete="0">
                <div>
                    <!-- MAIN TITLE: Auto Number Configuration -->
                    <div class="d-flex align-items-center pb-2 mb-4" style="border-bottom:2px solid #e2e8f0; width:100%;">
                        <i class="fa fa-sort-numeric-asc me-2" style="font-size:clamp(1.1rem, 1.5vw, 1.3rem); color:#0284c7;"></i>
                        <h2 style="font-size:clamp(1.15rem, 1.6vw, 1.35rem); font-weight:700; margin:0; color:#0f172a;">
                            Auto Number Configuration
                        </h2>
                    </div>

                    <!-- 2 SECTIONS IN ONE ROW (50% / 50%) -->
                    <div class="row g-4" style="width:100%; margin:0;">
                        <!-- SECTION 1: Equipment Master (Left) -->
                        <div class="col-12 col-lg-6 ps-0 pe-lg-3">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fa fa-cogs me-2" style="font-size:clamp(0.95rem, 1.2vw, 1.1rem); color:#0284c7;"></i>
                                <h3 style="font-size:clamp(1rem, 1.3vw, 1.15rem); font-weight:600; margin:0; color:#1e293b;">
                                    Equipment Master
                                </h3>
                            </div>
                            <div class="p-4 border rounded-3 bg-white shadow-sm">
                                <!-- 1. Equipment ID Block -->
                                <div class="pb-4 mb-4 border-bottom">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="d-flex align-items-center">
                                            <i class="fa fa-tag me-2 text-info" style="font-size:clamp(0.9rem, 1.2vw, 1rem);"></i>
                                            <strong style="font-size:clamp(0.92rem, 1.15vw, 1.05rem); color:#0f172a;">Equipment ID</strong>
                                        </div>
                                        <div class="form-check form-switch mb-0">
                                            <field name="equipment_id_auto" widget="boolean_toggle"/>
                                        </div>
                                    </div>

                                    <div invisible="not equipment_id_auto" class="mt-2">
                                        <group col="3" class="mb-2">
                                            <field name="equipment_id_prefix" string="Prefix" placeholder="e.g. EQ-"/>
                                            <field name="equipment_id_next" string="Number"/>
                                            <field name="equipment_id_suffix" string="Suffix" placeholder="e.g. -IND"/>
                                        </group>
                                        <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light border mt-2">
                                            <span class="text-muted small">Live Sample:</span>
                                            <span class="badge fs-6 px-3 py-1 font-monospace" style="background-color:#0284c7; color:#ffffff;">
                                                <field name="equipment_id_preview" readonly="1"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- 2. Serial Number Block -->
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="d-flex align-items-center">
                                            <i class="fa fa-barcode me-2 text-info" style="font-size:clamp(0.9rem, 1.2vw, 1rem);"></i>
                                            <strong style="font-size:clamp(0.92rem, 1.15vw, 1.05rem); color:#0f172a;">Serial Number</strong>
                                        </div>
                                        <div class="form-check form-switch mb-0">
                                            <field name="serial_number_auto" widget="boolean_toggle"/>
                                        </div>
                                    </div>

                                    <div invisible="not serial_number_auto" class="mt-2">
                                        <group col="3" class="mb-2">
                                            <field name="serial_number_prefix" string="Prefix" placeholder="e.g. SN-"/>
                                            <field name="serial_number_next" string="Number"/>
                                            <field name="serial_number_suffix" string="Suffix" placeholder="e.g. -2026"/>
                                        </group>
                                        <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light border mt-2">
                                            <span class="text-muted small">Live Sample:</span>
                                            <span class="badge fs-6 px-3 py-1 font-monospace" style="background-color:#0284c7; color:#ffffff;">
                                                <field name="serial_number_preview" readonly="1"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- SECTION 2: Service Ticket (Right) -->
                        <div class="col-12 col-lg-6 pe-0 ps-lg-3">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fa fa-wrench me-2" style="font-size:clamp(0.95rem, 1.2vw, 1.1rem); color:#0284c7;"></i>
                                <h3 style="font-size:clamp(1rem, 1.3vw, 1.15rem); font-weight:600; margin:0; color:#1e293b;">
                                    Service Ticket
                                </h3>
                            </div>
                            <div class="p-4 border rounded-3 bg-white shadow-sm">
                                <!-- Ticket ID Block -->
                                <div class="pb-4 mb-4">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="d-flex align-items-center">
                                            <i class="fa fa-ticket me-2 text-info" style="font-size:clamp(0.9rem, 1.2vw, 1rem);"></i>
                                            <strong style="font-size:clamp(0.92rem, 1.15vw, 1.05rem); color:#0f172a;">Ticket ID</strong>
                                        </div>
                                        <div class="form-check form-switch mb-0">
                                            <field name="ticket_id_auto" widget="boolean_toggle"/>
                                        </div>
                                    </div>

                                    <div invisible="not ticket_id_auto" class="mt-2">
                                        <group col="3" class="mb-2">
                                            <field name="ticket_id_prefix" string="Prefix" placeholder="e.g. TCK-"/>
                                            <field name="ticket_id_next" string="Number"/>
                                            <field name="ticket_id_suffix" string="Suffix" placeholder="e.g. -2026"/>
                                        </group>
                                        <div class="d-flex align-items-center justify-content-between p-2 rounded bg-light border mt-2">
                                            <span class="text-muted small">Live Sample:</span>
                                            <span class="badge fs-6 px-3 py-1 font-monospace" style="background-color:#0284c7; color:#ffffff;">
                                                <field name="ticket_id_preview" readonly="1"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- MAIN TITLE: Expense Configuration -->
                <div class="d-flex align-items-center pb-2 mb-4 mt-5" style="border-bottom:2px solid #e2e8f0; width:100%;">
                    <i class="fa fa-credit-card me-2" style="font-size:clamp(1.1rem, 1.5vw, 1.3rem); color:#0284c7;"></i>
                    <h2 style="font-size:clamp(1.15rem, 1.6vw, 1.35rem); font-weight:700; margin:0; color:#0f172a;">
                        Expense Configuration
                    </h2>
                </div>

                <div class="row g-4" style="width:100%; margin:0;">
                    <div class="col-12 ps-0 pe-0">
                        <div class="p-4 border rounded-3 bg-white shadow-sm w-100">
                            <div class="d-flex align-items-center mb-1">
                                <i class="fa fa-tags me-2 text-info" style="font-size:clamp(0.9rem, 1.2vw, 1rem);"></i>
                                <strong style="font-size:clamp(0.92rem, 1.15vw, 1.05rem); color:#0f172a;">Service Ticket Expense Types</strong>
                            </div>
                            <p class="text-muted small mb-3">Add expense categories below. All added types will show in the list with active status.</p>

                            <!-- Direct Inline Input Box (Quick Add) -->
                            <div class="d-flex align-items-center gap-2 mb-3" style="max-width: 600px;">
                                <field name="new_expense_type_name" nolabel="1" class="flex-grow-1" placeholder="Type expense name (e.g. Travel, Food, Fuel)..."/>
                                <button name="action_add_expense_type" string="+ Add Expense" type="object" class="btn btn-primary btn-sm px-3"/>
                            </div>

                            <!-- The List View Right Here on this card -->
                            <style>
                                .o_expense_type_table .o_field_x2many_list_row_add,
                                .o_expense_type_table tfoot {
                                    display: none !important;
                                }
                            </style>
                            <field name="expense_type_ids" class="o_expense_type_table" context="{'active_test': False}" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}">
                                <list editable="bottom" create="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Expense Type"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <!-- Action to open this custom settings view -->
    <record id="action_crm_custom_settings" model="ir.actions.act_window">
        <field name="name">CRM Settings</field>
        <field name="res_model">crm.custom.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- Sequence Form: Equipment Series Name Dropdown, Category Selection & Hide Company -->
    <record id="view_sequence_form_equipment_category_inherit" model="ir.ui.view">
        <field name="name">ir.sequence.form.equipment.category.inherit</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view"/>
        <field name="arch" type="xml">
            <!-- 1. Hide normal text Name for equipment sequences -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">code in ('crm.equipment.id', 'crm.equipment.serial')</attribute>
            </xpath>

            <!-- 2. Show Selection Dropdown for Name (Equipment ID / Serial Number) -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="equipment_sequence_type" 
                       string="Name"
                       invisible="code not in ('crm.equipment.id', 'crm.equipment.serial')"
                       placeholder="Select Equipment ID or Serial Number..."/>
            </xpath>

            <!-- 3. Category: show ONLY when Equipment ID is selected -->
            <xpath expr="//field[@name='code']" position="after">
                <field name="equipment_category_id" 
                       string="Category" 
                       invisible="code != 'crm.equipment.id' and equipment_sequence_type != 'equipment_id'"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" 
                       placeholder="Optional (Leave blank for default series)..."/>
            </xpath>

            <!-- 4. Hide Company field -->
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="invisible">code in ('crm.equipment.id', 'crm.equipment.serial', 'service.ticket')</attribute>
            </xpath>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_sequence_tree_equipment_inherit" model="ir.ui.view">
        <field name="name">ir.sequence.tree.equipment.inherit</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="column_invisible">context.get('default_code') in ('crm.equipment.id', 'crm.equipment.serial', 'service.ticket')</attribute>
            </xpath>
            <xpath expr="//field[@name='prefix']" position="after">
                <field name="equipment_category_id" 
                       string="Category" 
                       column_invisible="context.get('default_code') != 'crm.equipment.id'"/>
            </xpath>
        </field>
    </record>

        <!-- Inherit ir.sequence Tree to hide Company column and show Equipment Category -->
    <record id="view_sequence_tree_equipment_inherit" model="ir.ui.view">
        <field name="name">ir.sequence.tree.equipment.inherit</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="column_invisible">context.get('default_code') in ('crm.equipment.id', 'crm.equipment.serial', 'service.ticket')</attribute>
            </xpath>
            <xpath expr="//field[@name='prefix']" position="after">
                <field name="equipment_category_id" 
                       string="Equipment Category" 
                       column_invisible="context.get('default_code') != 'crm.equipment.id'"/>
            </xpath>
        </field>
    </record>
</odoo>
