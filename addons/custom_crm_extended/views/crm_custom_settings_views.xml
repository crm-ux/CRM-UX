<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_custom_settings_form" model="ir.ui.view">
        <field name="name">crm.custom.settings.form</field>
        <field name="model">crm.custom.settings</field>
        <field name="arch" type="xml">
            <form string="CRM Settings" create="0" delete="0">
                <sheet>
                    <!-- Settings Header -->
                    <div class="oe_title mb-4">
                        <h1 style="font-size:clamp(1.4rem, 2.2vw, 1.8rem); font-weight:700; color:#0f172a;">
                            CRM System Settings
                        </h1>
                    </div>

                    <div>
                        <!-- MAIN TITLE: Auto Number Configuration -->
                        <div class="d-flex align-items-center pb-2 mb-4" style="border-bottom:2px solid #e2e8f0; width:100%;">
                            <i class="fa fa-sort-numeric-asc me-2" style="font-size:clamp(1.1rem, 1.5vw, 1.3rem); color:#0284c7;"></i>
                            <h2 style="font-size:clamp(1.15rem, 1.6vw, 1.35rem); font-weight:700; margin:0; color:#0f172a;">
                                Auto Number Configuration
                            </h2>
                        </div>

                        <!-- 2 SECTIONS IN ONE ROW (50% / 50%) -->
                        <div class="row g-4" style="width:100%; margin:0;">
                            <!-- SECTION 1: Equipment Master (Left) -->
                            <div class="col-12 col-lg-6 ps-0 pe-lg-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fa fa-cogs me-2" style="font-size:clamp(0.95rem, 1.2vw, 1.1rem); color:#0284c7;"></i>
                                    <h3 style="font-size:clamp(1rem, 1.3vw, 1.15rem); font-weight:600; margin:0; color:#1e293b;">
                                        Equipment Master
                                    </h3>
                                </div>
                                <div class="p-3 border rounded-3 bg-white shadow-sm" style="min-height:clamp(12rem, 24vh, 16rem);">
                                    <!-- 1. Equipment ID Setting -->
                                    <div class="pb-3 mb-3 border-bottom">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-tag me-2 text-primary"></i>
                                                <strong style="font-size:clamp(0.88rem, 1.1vw, 0.95rem); color:#0f172a;">Equipment ID</strong>
                                            </div>
                                            <div class="form-check form-switch mb-0">
                                                <field name="equipment_id_auto" widget="boolean_toggle"/>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 mt-2" invisible="not equipment_id_auto">
                                            <label for="equipment_id_prefix" class="text-muted small mb-0" style="min-width:clamp(4rem, 6vw, 5rem);">Prefix:</label>
                                            <field name="equipment_id_prefix" placeholder="e.g. EQ" class="form-control form-control-sm" style="max-width:clamp(8rem, 12vw, 10rem);"/>
                                        </div>
                                    </div>

                                    <!-- 2. Serial Number Setting -->
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center">
                                                <i class="fa fa-barcode me-2 text-primary"></i>
                                                <strong style="font-size:clamp(0.88rem, 1.1vw, 0.95rem); color:#0f172a;">Serial Number</strong>
                                            </div>
                                            <div class="form-check form-switch mb-0">
                                                <field name="serial_number_auto" widget="boolean_toggle"/>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 mt-2" invisible="not serial_number_auto">
                                            <label for="serial_number_prefix" class="text-muted small mb-0" style="min-width:clamp(4rem, 6vw, 5rem);">Prefix:</label>
                                            <field name="serial_number_prefix" placeholder="e.g. SN" class="form-control form-control-sm" style="max-width:clamp(8rem, 12vw, 10rem);"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- SECTION 2: Service Ticket (Right) -->
                            <div class="col-12 col-lg-6 pe-0 ps-lg-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fa fa-wrench me-2" style="font-size:clamp(0.95rem, 1.2vw, 1.1rem); color:#0284c7;"></i>
                                    <h3 style="font-size:clamp(1rem, 1.3vw, 1.15rem); font-weight:600; margin:0; color:#1e293b;">
                                        Service Ticket
                                    </h3>
                                </div>
                                <div class="p-4 border rounded-3 bg-light" style="min-height:clamp(10rem, 20vh, 14rem);">
                                    <p class="text-muted mb-0" style="font-size:clamp(0.85rem, 1vw, 0.92rem); line-height:1.6;">
                                        <!-- Service Ticket fields will be placed here -->
                                        Configure auto-incrementing numbering rules and formats for Service Ticket records.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open this custom settings view -->
    <record id="action_crm_custom_settings" model="ir.actions.act_window">
        <field name="name">CRM Settings</field>
        <field name="res_model">crm.custom.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
