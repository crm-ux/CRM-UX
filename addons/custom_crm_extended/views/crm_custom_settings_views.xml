<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_custom_settings_form" model="ir.ui.view">
        <field name="name">crm.custom.settings.form</field>
        <field name="model">crm.custom.settings</field>
        <field name="arch" type="xml">
            <form string="CRM Settings" create="0" delete="0">
                <sheet>
                    <!-- Settings Page Title -->
                    <div class="oe_title mb-4">
                        <h1 style="font-size:clamp(1.4rem, 2.2vw, 1.8rem); font-weight:700; color:#0f172a;">
                            CRM System Settings
                        </h1>
                        <p class="text-muted" style="font-size:clamp(0.85rem, 1.2vw, 0.95rem);">
                            Manage your system numbering formats, auto-increment rules, and global configurations.
                        </p>
                    </div>

                    <div class="o_settings_container">
                        <!-- SECTION 1: Numbering Master -->
                        <div class="row mt-4 mb-3 border-bottom pb-2">
                            <div class="col-12 d-flex align-items-center">
                                <i class="fa fa-sliders me-2" style="font-size:1.2rem; color:#0284c7;"></i>
                                <h3 style="font-size:1.15rem; font-weight:600; margin:0; color:#1e293b;">
                                    Numbering Master &amp; Sequences
                                </h3>
                            </div>
                        </div>

                        <div class="row g-3">
                            <!-- Card 1: Sequences & Auto Numbers -->
                            <div class="col-12 col-md-6">
                                <div class="p-3 border rounded-3 bg-light d-flex flex-column justify-content-between h-100">
                                    <div>
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fa fa-sort-numeric-asc me-2 text-primary"></i>
                                            <strong style="font-size:1rem; color:#0f172a;">Multi-Segment Auto Numbering</strong>
                                        </div>
                                        <p class="text-muted mb-3" style="font-size:0.875rem; line-height:1.5;">
                                            Configure auto-incrementing ID formats for Service Tickets, Equipment Master, Serial Numbers, and Child Part Numbers with custom prefixes, year, month, and separators.
                                        </p>
                                    </div>
                                    <div>
                                        <button name="action_open_numbering_master" 
                                                string="Configure Numbering Sequences" 
                                                type="object" 
                                                class="btn btn-primary btn-sm px-3 py-1"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 2: Future Configuration (e.g. Service Ticket Defaults) -->
                            <div class="col-12 col-md-6">
                                <div class="p-3 border rounded-3 bg-light d-flex flex-column justify-content-between h-100 opacity-75">
                                    <div>
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fa fa-wrench me-2 text-secondary"></i>
                                            <strong style="font-size:1rem; color:#0f172a;">Service &amp; Equipment Defaults</strong>
                                        </div>
                                        <p class="text-muted mb-3" style="font-size:0.875rem; line-height:1.5;">
                                            Set default warranty durations, preventive maintenance schedules, and priority rules.
                                        </p>
                                    </div>
                                    <div>
                                        <span class="badge bg-secondary">Coming Soon</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 2: Future Section placeholder -->
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open this custom settings view -->
    <record id="action_crm_custom_settings" model="ir.actions.act_window">
        <field name="name">CRM Settings</field>
        <field name="res_model">crm.custom.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
