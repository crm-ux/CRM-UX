<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_setting_form" model="ir.ui.view">
        <field name="name">expense.setting.form</field>
        <field name="model">expense.setting</field>
        <field name="arch" type="xml">
            <form string="Voucher Management" create="0" delete="0">
                <!-- MAIN TITLE: Voucher Management -->
                <div class="d-flex align-items-center justify-content-between pb-2 mb-4 mt-5" style="border-bottom:2px solid #e2e8f0; width:100%;">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-money me-2" style="font-size:clamp(1.1rem, 1.5vw, 1.3rem); color:#0284c7;"></i>
                        <h2 style="font-size:clamp(1.15rem, 1.6vw, 1.35rem); font-weight:700; margin:0; color:#0f172a;">
                            Voucher Configuration &amp; Settings
                        </h2>
                    </div>
                    <div>
                        <button string="← Back to Submissions" type="object" name="action_back_to_submissions" class="btn btn-sm fw-semibold" style="color: #0b3d91 !important; border-color: #0b3d91 !important;"/>
                    </div>
                </div>

                <div class="row g-4 mb-4" style="width:100%; margin:0;">
                    <!-- CARD: Authorized Expense / Voucher Managers -->
                    <div class="col-12 ps-0 pe-0">
                        <div class="p-4 border rounded-3 bg-white shadow-sm w-100" style="border-left: 4px solid #0284c7 !important;">
                            <div class="d-flex align-items-center mb-1">
                                <i class="fa fa-user-shield me-2 text-primary" style="font-size:clamp(0.9rem, 1.2vw, 1rem);"></i>
                                <strong style="font-size:clamp(0.92rem, 1.15vw, 1.05rem); color:#0f172a;">Global Authorized Expense / Voucher Managers</strong>
                            </div>
                            <p class="text-muted small mb-3">By default, System Administrators have full access. Select specific users who are granted permission to access and approve vouchers globally alongside Admins.</p>

                            <field name="authorized_manager_ids" widget="many2many_tags" options="{'no_create': True, 'color_field': 'color'}" placeholder="Select authorized managers (e.g. Accounts Head, Operation Manager)..."/>
                        </div>
                    </div>
                </div>

                <!-- CARD: Department-wise Voucher Approver Settings with Active Toggle -->
                <div class="row g-4 mb-4" style="width:100%; margin:0;">
                    <div class="col-12 ps-0 pe-0">
                        <div class="p-4 border rounded-3 bg-white shadow-sm w-100" style="border-left: 4px solid #10b981 !important;">
                            <div class="d-flex align-items-center mb-1">
                                <i class="fa fa-building me-2 text-success" style="font-size:clamp(0.9rem, 1.2vw, 1rem);"></i>
                                <strong style="font-size:clamp(0.92rem, 1.15vw, 1.05rem); color:#0f172a;">Department-wise Voucher Approver &amp; Status</strong>
                            </div>
                            <p class="text-muted small mb-3">Assign designated voucher approvers per department. Use the Active toggle to enable/disable approval rights dynamically.</p>

                            <field name="department_ids" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="name" string="Department" readonly="1" class="fw-bold"/>
                                    <field name="manager_user_id" string="Department Head" readonly="1"/>
                                    <field name="voucher_manager_id" string="Voucher Approver" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="voucher_approval_active" string="Active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </div>

                <!-- CARD: Expense Types & Per-Visit Cost Limits by Job Position -->
                <div class="row g-4" style="width:100%; margin:0;">
                    <div class="col-12 ps-0 pe-0">
                        <div class="p-4 border rounded-3 bg-white shadow-sm w-100">
                            <div class="d-flex align-items-center mb-1">
                                <i class="fa fa-tags me-2 text-info" title="Expense Types" style="font-size:clamp(0.9rem, 1.2vw, 1rem);"></i>
                                <strong style="font-size:clamp(0.92rem, 1.15vw, 1.05rem); color:#0f172a;">Expense Types &amp; Per-Visit Cost Limits by Job Position</strong>
                            </div>
                            <p class="text-muted small mb-3">Add expense types with their allowed cost limit per visit. Select multiple Job Positions allowed to claim this expense (leave empty to allow all positions).</p>

                            <!-- Direct Inline Input Box (Quick Add) -->
                            <div class="row g-2 align-items-center mb-3">
                                <div class="col-12 col-md-3">
                                    <field name="new_expense_type_name" nolabel="1" placeholder="Expense Type Name (e.g. Food - Engineer, Food - Manager)..."/>
                                </div>
                                <div class="col-6 col-md-2">
                                    <field name="new_expense_type_budget_limit" placeholder="Limit Per Visit (₹)"/>
                                </div>
                                <div class="col-12 col-md-4">
                                    <field name="new_expense_type_job_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Allowed Job Positions (Multiple)..."/>
                                </div>
                                <div class="col-6 col-md-1 d-flex align-items-center gap-1">
                                    <field name="new_expense_type_is_km" widget="boolean_toggle"/>
                                    <label for="new_expense_type_is_km" string="KM?" class="m-0 small fw-semibold"/>
                                </div>
                                <div class="col-6 col-md-2 text-end">
                                    <button name="action_add_expense_type" string="+ Add Type" type="object" class="btn btn-sm w-100 text-white fw-bold" style="background-color: #0b3d91 !important; border-color: #0b3d91 !important;"/>
                                </div>
                            </div>

                            <!-- The List View Right Here on this card -->
                            <field name="expense_type_ids" class="o_expense_type_table" context="{'active_test': False}" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}">
                                <list editable="bottom" create="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Expense Type" class="fw-semibold"/>
                                    <field name="budget_limit" string="Limit Per Visit (₹)"/>
                                    <field name="job_ids" widget="many2many_tags" string="Allowed Job Positions" options="{'no_create': True}" placeholder="All Positions (Global)"/>
                                    <field name="is_km_based" string="KM Based?" widget="boolean_toggle"/>
                                    <field name="km_rate" string="Rate / KM (₹)"/>
                                    <field name="active" string="Active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <!-- Voucher Line Tree/List View: SUBMISSIONS SUMMARY LIST -->
    <record id="view_service_ticket_voucher_line_tree" model="ir.ui.view">
        <field name="name">service.ticket.voucher.line.tree</field>
        <field name="model">service.ticket.voucher.line</field>
        <field name="arch" type="xml">
            <list string="Submitted Vouchers" create="0" edit="0" delete="1" decoration-muted="status == 'rejected'" decoration-success="status == 'approved'">
                <field name="active" column_invisible="1"/>
                <field name="expense_date" string="Expense Date"/>
                <field name="create_date" string="Submitted Date" optional="hide"/>
                <field name="ticket_id" string="Service Ticket"/>
                <field name="submitted_by_user_id" string="Submitted By" widget="many2one_avatar_user"/>
                <field name="other_employee_names" string="Other Employees" optional="hide"/>
                <field name="expense_type_id" string="Expense Type"/>
                <field name="is_km_based" column_invisible="1"/>
                <field name="total_km" string="Total KM" optional="hide"/>
                <field name="rate_per_km" string="₹/KM" optional="hide"/>
                <field name="description" string="Description" optional="show"/> 
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total Amount" class="fw-bold text-end"/>
                <field name="bill_file" filename="bill_filename" widget="binary" string="Bill" options="{'no_download': True}" optional="show"/>
                <field name="bill_filename" column_invisible="1"/>
                <button name="action_preview_bill" type="object" icon="fa-eye" title="View Bill" invisible="not bill_file" class="btn p-0 text-primary"/>
                <field name="expense_manager_id" string="Approver" optional="hide"/>
                <field name="reject_reason" string="Reject Reason" optional="hide"/>
                <field name="status" widget="badge" decoration-warning="status == 'submitted'" decoration-success="status == 'approved'" decoration-danger="status == 'rejected'"/>
                <button name="action_approve" type="object" icon="fa-check text-success" title="Approve" invisible="status == 'approved'"/>
                <button name="action_reject" type="object" icon="fa-times text-danger" title="Reject" invisible="status == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Detail Form View: Opened directly when clicking any record in the list -->
    <record id="view_service_ticket_voucher_line_form" model="ir.ui.view">
        <field name="name">service.ticket.voucher.line.form</field>
        <field name="model">service.ticket.voucher.line</field>
        <field name="arch" type="xml">
            <form string="Expense Voucher Detail">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn btn-success" invisible="status == 'approved'"/>
                    <button name="action_reject" string="Reject" type="object" class="btn btn-danger" invisible="status == 'rejected'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title mb-3">
                        <h1>
                            <field name="user_id" readonly="1" options="{'no_open': True}"/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="ticket_id" readonly="1" options="{'no_open': True}"/>
                        </h4>
                    </div>

                    <!-- Horizontal Employee Names Strip in Blue (Same design as Service Ticket) -->
                    <div class="d-flex align-items-center gap-2 p-2 px-3 mb-3 rounded border bg-white shadow-sm"
                         invisible="not voucher_employee_names"
                         style="border-left: 4px solid #0b3d91 !important;">
                        <span class="small fw-bold" style="color: #0b3d91;">
                            <i class="fa fa-users me-1" style="color: #0b3d91;"></i>Employees:
                        </span>
                        <span class="badge py-1 px-2 fw-semibold" style="background-color: rgba(11, 61, 145, 0.1); color: #0b3d91; border: 1px solid rgba(11, 61, 145, 0.3); font-size: 0.9rem;">
                            <field name="voucher_employee_names" readonly="1" class="d-inline"/>
                        </span>
                    </div>

                    <group>
                        <group string="Submission Overview">
                            <field name="create_date" string="Submitted Date" readonly="1"/>
                            <field name="submitted_by_user_id" string="Submitted By" readonly="1" options="{'no_open': True}"/>
                        </group>
                        <group string="Approval Status">
                            <field name="expense_manager_id" readonly="1" string="Approver" options="{'no_open': True}"/>
                            <field name="reject_reason" readonly="1" invisible="not reject_reason"/>
                        </group>
                    </group>

                    <!-- Exact Expense Table (Identical to Service Ticket) -->
                    <separator string="Expenses"/>
                    <field name="ticket_voucher_line_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="user_id" string="Employee" widget="many2one_avatar_user" options="{'no_open': True}"/>
                            <field name="expense_type_id" string="Expense Type" options="{'no_open': True}"/>
                            <field name="description" string="Description"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="amount" sum="Total" class="fw-bold text-end"/>
                            <field name="bill_file" filename="bill_filename" widget="binary" string="Bill" options="{'no_download': True}"/>
                            <field name="bill_filename" column_invisible="1"/>
                            <button name="action_preview_bill" type="object" icon="fa-eye" title="View Bill" invisible="not bill_file" class="btn p-0" style="color: #0b3d91 !important;"/>
                            <field name="status" widget="badge" decoration-info="status == 'draft'" decoration-warning="status == 'submitted'" decoration-success="status == 'approved'" decoration-danger="status == 'rejected'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Voucher Batch List View: ONE ROW PER SUBMISSION/EMPLOYEE WITH TOTAL -->
    <record id="view_service_ticket_voucher_batch_tree" model="ir.ui.view">
        <field name="name">service.ticket.voucher.batch.tree</field>
        <field name="model">service.ticket.voucher.batch</field>
        <field name="arch" type="xml">
            <list string="Voucher Submissions" create="0" edit="0" delete="1" decoration-muted="status == 'rejected'" decoration-success="status == 'approved'">
                <field name="active" column_invisible="1"/>
                <field name="name" string="Voucher ID" class="fw-bold text-primary"/>
                <field name="create_date" string="Submitted Date"/>
                <field name="expense_dates" string="Expense Date(s)"/>
                <field name="ticket_id" string="Service Ticket" options="{'no_open': True}"/>
                <field name="all_employee_names" string="Employees"/>
                <field name="submitted_by_user_id" string="Submitted By" widget="many2one_avatar_user" options="{'no_open': True}"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_amount" sum="Total Amount" class="fw-bold text-end"/>
                <field name="expense_manager_id" string="Approver" options="{'no_open': True}"/>
                <field name="status" widget="badge" decoration-warning="status == 'submitted'" decoration-success="status == 'approved'" decoration-danger="status == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Voucher Batch Form View: Opens on click showing all individual expenses in a table -->
    <record id="view_service_ticket_voucher_batch_form" model="ir.ui.view">
        <field name="name">service.ticket.voucher.batch.form</field>
        <field name="model">service.ticket.voucher.batch</field>
        <field name="arch" type="xml">
            <form string="Voucher Submission Detail" create="0" edit="0" delete="0" class="o_service_ticket_voucher_batch_form">
                <header>
                    <button name="action_approve" string="Approve All" type="object" class="btn btn-success fw-bold px-3 py-1 shadow-sm" invisible="status == 'approved'"/>
                    <button name="action_reject" string="Reject All" type="object" class="btn btn-danger fw-bold px-3 py-1 shadow-sm" invisible="status == 'rejected'"/>
                    <field name="status" widget="statusbar" statusbar_visible="submitted,approved,rejected"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    
                    <!-- Clean Top Summary Strip (Matching Service Ticket) -->
                    <div class="d-flex align-items-center justify-content-between p-2 px-3 mb-3 rounded border bg-white shadow-sm flex-wrap"
                         style="border-left: 4px solid #0b3d91 !important;">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="small fw-bold" style="color: #0b3d91;">Voucher ID:</span>
                            <span class="badge py-1 px-2 fw-semibold" style="background-color: #e8f0fe; color: #0b3d91; border: 1px solid #b8d0f8; font-size: 0.9rem;">
                                <field name="name" readonly="1" class="d-inline"/>
                            </span>
                            <span class="text-muted ms-1">|</span>
                            <span class="small fw-bold text-dark ms-1">Submitted:</span>
                            <span class="badge py-1 px-2 fw-semibold" style="background-color: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; font-size: 0.9rem;">
                                <field name="create_date" readonly="1" class="d-inline"/>
                            </span>
                            <span class="text-muted ms-1">|</span>
                            <span class="small fw-bold text-dark ms-1">Expense Date(s):</span>
                            <span class="badge py-1 px-2 fw-semibold" style="background-color: #e8f0fe; color: #0b3d91; border: 1px solid #b8d0f8; font-size: 0.9rem;">
                                <field name="expense_dates" readonly="1" class="d-inline"/>
                            </span>
                            <span class="text-muted ms-1">|</span>
                            <span class="small fw-bold text-dark ms-1">Employees:</span>
                            <span class="badge py-1 px-2 fw-semibold" style="background-color: #e8f0fe; color: #0b3d91; border: 1px solid #b8d0f8; font-size: 0.9rem;">
                                <field name="all_employee_names" readonly="1" class="d-inline"/>
                            </span>
                            <span class="text-muted ms-1">|</span>
                            <span class="small fw-bold text-dark ms-1">Service Ticket:</span>
                            <field name="ticket_id" readonly="1" class="fw-bold text-primary"/>
                        </div>
                    </div>

                    <!-- Clean Expense Table -->
                    <separator string="Expense Details"/>
                    <field name="line_ids" readonly="1" class="o_voucher_card_list">
                        <list create="0" edit="0" delete="0">
                            <field name="expense_date" string="Expense Date"/>
                            <field name="user_id" string="Employee" widget="many2one_avatar_user" options="{'no_open': True}"/>
                            <field name="expense_type_id" string="Expense Type" options="{'no_open': True}"/>
                            <field name="is_km_based" column_invisible="1"/>
                            <field name="total_km" string="Total KM" optional="show"/>
                            <field name="rate_per_km" string="₹/KM" optional="show"/>
                            <field name="description" string="Description"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="amount" sum="Total" class="fw-bold text-end"/>
                            <field name="bill_file" filename="bill_filename" widget="binary" string="Bill" options="{'no_download': True}"/>
                            <field name="bill_filename" column_invisible="1"/>
                            <button name="action_preview_bill" type="object" icon="fa-eye" title="View Bill" invisible="not bill_file" class="btn p-0 text-primary"/>
                            <field name="status" widget="badge" decoration-warning="status == 'submitted'" decoration-success="status == 'approved'" decoration-danger="status == 'rejected'"/>
                            <button name="action_approve" type="object" icon="fa-check text-success" title="Approve" invisible="status == 'approved'"/>
                            <button name="action_reject" type="object" icon="fa-times text-danger" title="Reject" invisible="status == 'rejected'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for Voucher Batches -->
    <record id="view_service_ticket_voucher_batch_search" model="ir.ui.view">
        <field name="name">service.ticket.voucher.batch.search</field>
        <field name="model">service.ticket.voucher.batch</field>
        <field name="arch" type="xml">
            <search string="Search Voucher Submissions">
                <field name="user_id"/>
                <field name="submitted_by_user_id"/>
                <field name="ticket_id"/>
                <filter string="Submitted" name="status_submitted" domain="[('status', '=', 'submitted')]"/>
                <filter string="Approved" name="status_approved" domain="[('status', '=', 'approved')]"/>
                <filter string="Rejected" name="status_rejected" domain="[('status', '=', 'rejected')]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'user_id'}"/>
                    <filter string="Service Ticket" name="group_ticket" context="{'group_by': 'ticket_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action to open Voucher Submissions: One Row Per Submission with Total Amount, Click Opens Table -->
    <record id="action_service_ticket_voucher_line" model="ir.actions.act_window">
        <field name="name">Voucher Submissions</field>
        <field name="res_model">service.ticket.voucher.batch</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_service_ticket_voucher_batch_tree"/>
        <field name="search_view_id" ref="view_service_ticket_voucher_batch_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No vouchers yet
            </p>
            <p>
                All submitted expense vouchers and batches will appear here.
            </p>
        </field>
    </record>



    <!-- View Voucher Description Wizard Popup Form -->
    <record id="view_service_ticket_voucher_desc_wizard_form" model="ir.ui.view">
        <field name="name">service.ticket.voucher.desc.wizard.form</field>
        <field name="model">service.ticket.voucher.desc.wizard</field>
        <field name="arch" type="xml">
            <form string="Expense Description" class="o_service_ticket_voucher_desc_wizard">
                <div class="p-3 bg-light rounded border text-break fs-6" style="max-height: 55vh; overflow-y: auto; overflow-x: hidden; line-height: 1.6; word-break: break-all; white-space: pre-wrap;">
                    <field name="description" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button string="Close" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Description Wizard Popup -->
    <record id="action_service_ticket_voucher_desc_wizard" model="ir.actions.act_window">
        <field name="name">Expense Description</field>
        <field name="res_model">service.ticket.voucher.desc.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_service_ticket_voucher_desc_wizard_form"/>
        <field name="target">new</field>
    </record>

    <!-- Reject Voucher Remark Wizard Popup Form -->
    <record id="view_service_ticket_voucher_reject_wizard_form" model="ir.ui.view">
        <field name="name">service.ticket.voucher.reject.wizard.form</field>
        <field name="model">service.ticket.voucher.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Voucher Submission">
                <group>
                    <field name="voucher_line_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="employee_name" string="Employee" readonly="1"/>
                    <field name="expense_type_name" string="Expense Type" readonly="1"/>
                    <field name="amount" string="Amount" readonly="1"/>
                    <field name="reject_reason" string="Reason / Remark" placeholder="Enter reason or remark for rejection..." required="1"/>
                </group>
                <footer>
                    <button string="Reject Voucher" type="object" name="action_confirm_reject" class="btn btn-danger"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open voucher settings form -->
    <record id="action_expense_setting" model="ir.actions.act_window">
        <field name="name">Voucher Settings</field>
        <field name="res_model">expense.setting</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- Sequence Form: Equipment Series Name Dropdown, Category Selection & Hide Company -->
    <record id="view_sequence_form_equipment_category_inherit" model="ir.ui.view">
        <field name="name">ir.sequence.form.equipment.category.inherit</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view"/>
        <field name="arch" type="xml">
            <!-- 1. Hide normal text Name for equipment sequences -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">code in ('crm.equipment.id', 'crm.equipment.serial')</attribute>
            </xpath>

            <!-- 2. Show Selection Dropdown for Name (Equipment ID / Serial Number) -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="equipment_sequence_type" 
                       string="Name"
                       invisible="code not in ('crm.equipment.id', 'crm.equipment.serial')"
                       placeholder="Select Equipment ID or Serial Number..."/>
            </xpath>

            <!-- 3. Category: show ONLY when Equipment ID is selected -->
            <xpath expr="//field[@name='code']" position="after">
                <field name="equipment_category_id" 
                       string="Category" 
                       invisible="code != 'crm.equipment.id' and equipment_sequence_type != 'equipment_id'"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" 
                       placeholder="Optional (Leave blank for default series)..."/>
            </xpath>

            <!-- 4. Hide Company field -->
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="invisible">code in ('crm.equipment.id', 'crm.equipment.serial', 'service.ticket')</attribute>
            </xpath>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_sequence_tree_equipment_inherit" model="ir.ui.view">
        <field name="name">ir.sequence.tree.equipment.inherit</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="column_invisible">context.get('default_code') in ('crm.equipment.id', 'crm.equipment.serial', 'service.ticket','amc.contract')</attribute>
            </xpath>
            <xpath expr="//field[@name='prefix']" position="after">
                <field name="equipment_category_id" 
                       string="Category" 
                       column_invisible="context.get('default_code') != 'crm.equipment.id'"/>
            </xpath>
        </field>
    </record>
</odoo>
