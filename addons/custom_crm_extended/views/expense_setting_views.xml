<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_setting_form" model="ir.ui.view">
        <field name="name">expense.setting.form</field>
        <field name="model">expense.setting</field>
        <field name="arch" type="xml">
            <form string="Voucher Management" create="0" delete="0">
                <!-- MAIN TITLE: Voucher Management -->
                <div class="d-flex align-items-center justify-content-between pb-2 mb-4 mt-5" style="border-bottom:2px solid #e2e8f0; width:100%;">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-money me-2" style="font-size:clamp(1.1rem, 1.5vw, 1.3rem); color:#0284c7;"></i>
                        <h2 style="font-size:clamp(1.15rem, 1.6vw, 1.35rem); font-weight:700; margin:0; color:#0f172a;">
                            Voucher Configuration &amp; Settings
                        </h2>
                    </div>
                </div>

                <div class="row g-4 mb-4" style="width:100%; margin:0;">
                    <!-- CARD: Authorized Expense / Voucher Managers -->
                    <div class="col-12 ps-0 pe-0">
                        <div class="p-4 border rounded-3 bg-white shadow-sm w-100" style="border-left: 4px solid #0284c7 !important;">
                            <div class="d-flex align-items-center mb-1">
                                <i class="fa fa-user-shield me-2" style="color: #0b3d91 !important; font-size:clamp(0.9rem, 1.2vw, 1rem);"></i>
                                <strong style="font-size:clamp(0.92rem, 1.15vw, 1.05rem); color:#0f172a;">Global Authorized Expense / Voucher Managers</strong>
                            </div>
                            <p class="text-muted small mb-3">By default, System Administrators have full access. Select specific users who are granted permission to access and approve vouchers globally alongside Admins.</p>

                            <field name="authorized_manager_ids" widget="many2many_tags" options="{'no_create': True, 'color_field': 'color'}" placeholder="Select authorized managers (e.g. Accounts Head, Operation Manager)..."/>
                        </div>
                    </div>
                </div>

                <field name="has_active_department_approvers" invisible="1"/>

                <!-- CARD: Department-wise Voucher Approver Settings with Active Toggle -->
                <div class="row g-4 mb-4" style="width:100%; margin:0;">
                    <div class="col-12 ps-0 pe-0">
                        <div class="p-4 border rounded-3 bg-white shadow-sm w-100" style="border-left: 4px solid #0b3d91 !important;">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-building me-2" style="color: #0b3d91 !important; font-size:clamp(0.9rem, 1.2vw, 1rem);"></i>
                                    <strong style="font-size:clamp(0.92rem, 1.15vw, 1.05rem); color:#0f172a;">Department-wise Voucher Approver &amp; Status</strong>
                                </div>
                                <div class="d-flex align-items-center">
                                    <field name="show_department_table" widget="boolean_toggle" nolabel="1" readonly="has_active_department_approvers" class="crm_dept_toggle_switch"/>
                                </div>
                            </div>
                            <p class="text-muted small mb-3">Assign designated voucher approvers per department. Use the Active toggle to enable/disable approval rights dynamically.</p>

                            <field name="department_ids" invisible="not show_department_table" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="name" string="Department" readonly="1"/>
                                    <field name="voucher_approval_active" widget="boolean_toggle" string="Active"/>
                                    <field name="voucher_manager_id" 
                                           string="Designated Voucher Approver" 
                                           options="{'no_create': True, 'no_create_edit': True}"
                                           domain="[('share', '=', False)]"
                                           placeholder="Select Approver..."/>
                                    <field name="extra_department_ids"
                                           widget="many2many_tags"
                                           string="Extra Allowed Departments"
                                           domain="[('id', '!=', id)]"
                                           options="{'no_create': True, 'color_field': 'color'}"
                                           placeholder="Select other departments this approver can manage..."/>
                                </list>
                            </field>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4" style="width:100%; margin:0;">
                    <!-- CARD: Add New Expense Type -->
                    <div class="col-md-5 ps-0 pe-md-2 pe-0 mb-3 mb-md-0">
                        <div class="p-4 border rounded-3 bg-white shadow-sm h-100" style="border-left: 4px solid #10b981 !important;">
                            <div class="d-flex align-items-center mb-1">
                                <i class="fa fa-plus-circle me-2" style="color:#10b981; font-size:clamp(0.9rem, 1.2vw, 1rem);"></i>
                                <strong style="font-size:clamp(0.92rem, 1.15vw, 1.05rem); color:#0f172a;">Add New Expense Type</strong>
                            </div>
                            <p class="text-muted small mb-3">Create and configure allowance/expense categories with validation rules.</p>

                            <div class="mb-3">
                                <label for="new_expense_type_name" class="form-label text-muted small fw-bold mb-1">Expense Type Name</label>
                                <field name="new_expense_type_name" class="form-control" placeholder="e.g. Travel, Food, Hotel..."/>
                            </div>

                            <div class="mb-3">
                                <label for="new_expense_type_job_ids" class="form-label text-muted small fw-bold mb-1">Allowed Job Positions</label>
                                <field name="new_expense_type_job_ids" widget="many2many_tags" options="{'no_create': True, 'color_field': 'color'}" placeholder="Leave empty for all roles..."/>
                            </div>

                            <div class="mb-3 form-check form-switch ps-0 d-flex align-items-center">
                                <field name="new_expense_type_is_km" widget="boolean_toggle" class="me-2"/>
                                <label for="new_expense_type_is_km" class="form-check-label text-muted small fw-bold mb-0">Calculate by KM Distance</label>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6" invisible="not new_expense_type_is_km">
                                    <label for="new_expense_type_km_rate" class="form-label text-muted small fw-bold mb-1">Rate per KM (₹)</label>
                                    <field name="new_expense_type_km_rate" class="form-control"/>
                                </div>
                                <div class="col-6" invisible="new_expense_type_is_km">
                                    <label for="new_expense_type_budget_limit" class="form-label text-muted small fw-bold mb-1">Limit Per Visit (₹)</label>
                                    <field name="new_expense_type_budget_limit" class="form-control"/>
                                </div>
                            </div>

                            <button name="action_add_expense_type" type="object" string="Add Expense Type" class="btn btn-primary w-100" style="background:#0284c7; border:none; font-weight:600; padding: 0.5rem 1rem; border-radius: 6px;"/>
                        </div>
                    </div>

                    <!-- CARD: Active Expense Types List -->
                    <div class="col-md-7 pe-0 ps-md-2 ps-0">
                        <div class="p-4 border rounded-3 bg-white shadow-sm h-100" style="border-left: 4px solid #6366f1 !important;">
                            <div class="d-flex align-items-center mb-1">
                                <i class="fa fa-list-ul me-2" style="color:#6366f1; font-size:clamp(0.9rem, 1.2vw, 1rem);"></i>
                                <strong style="font-size:clamp(0.92rem, 1.15vw, 1.05rem); color:#0f172a;">Configured Expense Types</strong>
                            </div>
                            <p class="text-muted small mb-3">Directly edit rate per KM, per-visit limits, allowed job positions, or activate/deactivate types.</p>

                            <field name="expense_type_ids" nolabel="1">
                                <list editable="bottom" create="0">
                                    <field name="name" string="Name"/>
                                    <field name="is_km" string="By KM" widget="boolean_toggle"/>
                                    <field name="km_rate" string="Rate/KM (₹)" readonly="not is_km"/>
                                    <field name="budget_limit" string="Limit/Visit (₹)" readonly="is_km"/>
                                    <field name="job_ids" widget="many2many_tags" options="{'no_create': True, 'color_field': 'color'}" string="Allowed Positions"/>
                                    <field name="active" widget="boolean_toggle" string="Active"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </div>

            </form>
        </field>
    </record>

    <!-- Reject Voucher Remark Wizard Popup Form -->
    <record id="view_service_ticket_voucher_reject_wizard_form" model="ir.ui.view">
        <field name="name">service.ticket.voucher.reject.wizard.form</field>
        <field name="model">service.ticket.voucher.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Voucher Submission">
                <group>
                    <field name="voucher_line_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="employee_name" string="Employee" readonly="1"/>
                    <field name="expense_type_name" string="Expense Type" readonly="1"/>
                    <field name="amount" string="Amount" readonly="1"/>
                    <field name="reject_reason" string="Reason / Remark" placeholder="Enter reason or remark for rejection..." required="1"/>
                </group>
                <footer>
                    <button string="Reject Voucher" type="object" name="action_confirm_reject" class="btn btn-danger"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open voucher settings form -->
    <record id="action_expense_setting" model="ir.actions.act_window">
        <field name="name">Voucher Management</field>
        <field name="res_model">expense.setting</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="res_id" eval="1"/>
    </record>

    <!-- Sequence Form: Equipment Series Name Dropdown, Category Selection & Hide Company -->
    <record id="view_sequence_form_equipment_category_inherit" model="ir.ui.view">
        <field name="name">ir.sequence.form.equipment.category.inherit</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view"/>
        <field name="arch" type="xml">
            <!-- 1. Hide normal text Name for equipment sequences -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="invisible">code in ('crm.equipment.id', 'crm.equipment.serial')</attribute>
            </xpath>

            <!-- 2. Show Selection Dropdown for Name (Equipment ID / Serial Number) -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="equipment_sequence_type" 
                       string="Name"
                       invisible="code not in ('crm.equipment.id', 'crm.equipment.serial')"
                       placeholder="Select Equipment ID or Serial Number..."/>
            </xpath>

            <!-- 3. Category: show ONLY when Equipment ID is selected -->
            <xpath expr="//field[@name='code']" position="after">
                <field name="equipment_category_id" 
                       string="Category" 
                       invisible="code != 'crm.equipment.id' and equipment_sequence_type != 'equipment_id'"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" 
                       placeholder="Optional (Leave blank for default series)..."/>
            </xpath>

            <!-- 4. Hide Company field -->
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="invisible">code in ('crm.equipment.id', 'crm.equipment.serial', 'service.ticket')</attribute>
            </xpath>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_sequence_tree_equipment_inherit" model="ir.ui.view">
        <field name="name">ir.sequence.tree.equipment.inherit</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="column_invisible">context.get('default_code') in ('crm.equipment.id', 'crm.equipment.serial', 'service.ticket','amc.contract')</attribute>
            </xpath>
            <xpath expr="//field[@name='prefix']" position="after">
                <field name="equipment_category_id" 
                       string="Category" 
                       column_invisible="context.get('default_code') != 'crm.equipment.id'"/>
            </xpath>
        </field>
    </record>
</odoo>
