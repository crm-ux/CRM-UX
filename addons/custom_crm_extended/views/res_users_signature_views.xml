<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_signature_card" model="ir.ui.view">
        <field name="name">res.users.form.signature.card</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
             <xpath expr="//button[@name='action_create_employee']" position="attributes">
                <attribute name="invisible">employee_count &gt; 0 or employee_id</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <!-- Tab: Organization & Hierarchy -->
                <page string="Organization &amp; Hierarchy" name="org_hierarchy_page">
                    <group>
                        <group string="Role &amp; Hierarchy">
                            <field name="crm_job_id" string="Job Position / Role" options="{'quick_create': True}"/>
                            <field name="crm_manager_id" string="Reports To (Manager)" options="{'no_create': True}"/>
                            <field name="crm_department_id" string="Department" options="{'quick_create': True}"/>
                        </group>
                        <group string="Employee Profile &amp; Tags">
                            <field name="crm_employee_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" placeholder="Add tags..."/>
                            <field name="employee_id" readonly="1" string="Linked Employee Profile"/>
                        </group>
                    </group>
                </page>

                <page string="Quotation Signature Card" name="signature_card_page">
                    <group>
                        <field name="x_signature_card" widget="image" options="{'size': [350, 200]}"/>
                    </group>
                    <p class="text-muted">
                        Upload the business card / signature image to appear at the bottom of quotations sent by this user.
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
