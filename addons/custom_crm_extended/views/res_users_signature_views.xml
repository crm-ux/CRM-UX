<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- User Form View Extension -->
    <record id="view_users_form_signature_card" model="ir.ui.view">
        <field name="name">res.users.form.signature.card</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- Tab: Organization & Hierarchy -->
                <page string="Organization &amp; Hierarchy" name="org_hierarchy_page">
                    <group>
                        <!-- Left Column -->
                        <group string="Role &amp; Hierarchy">
                            <field name="crm_job_id" string="Job Position / Role" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="crm_manager_id" string="Reports To (Manager)" options="{'no_create': True, 'no_open': True}"/>
                            <field name="crm_expense_manager_id" string="Expense / Voucher Approver" options="{'no_create': True, 'no_open': True}"/>
                            <field name="crm_department_id" string="Department" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        </group>
                        <!-- Right Column --> 
                        <group string="Employee Profile &amp; Tags">
                            <field name="crm_employee_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True, 'no_create_edit': True}" placeholder="Select tags..."/>
                            <field name="employee_id" readonly="1" string="Linked Employee Profile"/>
                        </group>
                    </group>

                    <!-- Subordinates / Direct Reports Table -->
                    <group string="Subordinates / Direct Reports" invisible="not crm_subordinate_ids">
                        <field name="crm_subordinate_ids" nolabel="1" readonly="1">
                            <tree create="false" edit="false" delete="false">
                                <field name="name" string="Member Name"/>
                                <field name="crm_job_id" string="Job Position / Role"/>
                                <field name="crm_department_id" string="Department"/>
                                <field name="login" string="Email"/>
                            </tree>
                        </field>
                    </group>
                </page>

                <page string="Quotation Signature Card" name="signature_card_page">
                    <group>
                        <field name="x_signature_card" widget="image" options="{'size': [350, 200]}"/>
                    </group>
                    <p class="text-muted">
                        Upload the business card / signature image to appear at the bottom of quotations sent by this user.
                    </p>
                </page>
            </xpath>
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Configuration &amp; Masters">
                    <group>
                        <field name="perm_service_ticket" string="Service Ticket"/>
                        <field name="perm_amc" string="AMC Contract"/>
                        <field name="perm_company" string="Company Creation"/>
                        <field name="perm_export" string="Excel Export"/>
                    </group>
                    
                    <group>
                        <label for="perm_customer_create" string="Customer Creation"/>
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_customer_create" nolabel="1"/> Create</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_customer_write" nolabel="1"/> Update</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_customer_read" nolabel="1"/> View</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_customer_unlink" nolabel="1"/> Delete</span>
                        </div>

                        <label for="perm_equipment_create" string="Equipment Master"/>
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_equipment_create" nolabel="1"/> Create</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_equipment_write" nolabel="1"/> Update</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_equipment_read" nolabel="1"/> View</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_equipment_unlink" nolabel="1"/> Delete</span>
                        </div>

                        <label for="perm_product_create" string="Product Catalog"/>
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_product_create" nolabel="1"/> Create</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_product_write" nolabel="1"/> Update</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_product_read" nolabel="1"/> View</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_product_unlink" nolabel="1"/> Delete</span>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Clean Unified Roles & Groups (hr.job) Form View -->
    <record id="view_hr_job_form_crm_clean" model="ir.ui.view">
        <field name="name">hr.job.form.crm.clean</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="replace">
                <group>
                    <group string="Organization &amp; Department Scope">
                        <field name="department_id" string="Primary Department" options="{'no_create': True, 'no_open': True}"/>
                        <field name="is_manager_role" string="Is Manager / Head " widget="boolean_toggle" groups="base.group_erp_manager"/>
                        <field name="default_manager_id" string="Reporting Manager" readonly="1" force_save="1" options="{'no_create': True, 'no_open': True}"/>
                        <field name="sub_department_ids" widget="many2many_tags" 
                               string="Managed Sub-Departments"
                               options="{'color_field': 'color', 'no_create': True}"
                               placeholder="Optional: sub-departments managed under this role..."/>
                        <field name="company_id" string="Company" placeholder="Global (All Companies)"/>
                    </group>
                    <group string="Assigned Users">
                        <field name="user_ids" widget="many2many_tags" readonly="1" string="Users with this Role"/>
                    </group>
                </group>
                <group string="Permissions" class="custom_radio_clean">
                    <field name="perm_lead_quote" widget="radio" options="{'horizontal': true}"/>
                    <field name="perm_service_ticket" widget="radio" options="{'horizontal': true}"/>
                    <field name="perm_amc" widget="radio" options="{'horizontal': true}"/>
                    
                    <label for="perm_customer_create" string="Customer Creation"/>
                    <div class="perm-checkbox-group">
                        <span class="perm-checkbox-item"><field name="perm_customer_create" nolabel="1"/> <span>Create</span></span>
                        <span class="perm-checkbox-item"><field name="perm_customer_write" nolabel="1"/> <span>Update</span></span>
                        <span class="perm-checkbox-item"><field name="perm_customer_read" nolabel="1"/> <span>View</span></span>
                        <span class="perm-checkbox-item"><field name="perm_customer_unlink" nolabel="1"/> <span>Delete</span></span>
                    </div>

                    <label for="perm_equipment_create" string="Equipment Master"/>
                    <div class="perm-checkbox-group">
                        <span class="perm-checkbox-item"><field name="perm_equipment_create" nolabel="1"/> <span>Create</span></span>
                        <span class="perm-checkbox-item"><field name="perm_equipment_write" nolabel="1"/> <span>Update</span></span>
                        <span class="perm-checkbox-item"><field name="perm_equipment_read" nolabel="1"/> <span>View</span></span>
                        <span class="perm-checkbox-item"><field name="perm_equipment_unlink" nolabel="1"/> <span>Delete</span></span>
                    </div>

                    <label for="perm_product_create" string="Product Catalog"/>
                    <div class="perm-checkbox-group">
                        <span class="perm-checkbox-item"><field name="perm_product_create" nolabel="1"/> <span>Create</span></span>
                        <span class="perm-checkbox-item"><field name="perm_product_write" nolabel="1"/> <span>Update</span></span>
                        <span class="perm-checkbox-item"><field name="perm_product_read" nolabel="1"/> <span>View</span></span>
                        <span class="perm-checkbox-item"><field name="perm_product_unlink" nolabel="1"/> <span>Delete</span></span>
                    </div>

                    <field name="perm_export" widget="radio" options="{'horizontal': true}"/>
                    <field name="perm_company" widget="radio" options="{'horizontal': true}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Employee Form View Extension: Add Expense / Voucher Approver -->
    <record id="view_employee_form_crm_custom" model="ir.ui.view">
        <field name="name">hr.employee.form.crm.custom</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="expense_manager_id" string="Expense / Voucher Approver" widget="many2one_avatar_user"/>
            </xpath>
        </field>
    </record>

    <!-- Department Form View Extension -->
    <record id="view_department_form_crm_hierarchy" model="ir.ui.view">
        <field name="name">hr.department.form.crm.hierarchy</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Department Members" name="dept_members_page">
                        <group>
                            <field name="member_user_ids" widget="many2many_tags" readonly="1" string="Department Members"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

</odoo>
