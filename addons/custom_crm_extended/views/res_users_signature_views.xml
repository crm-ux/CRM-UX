<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Guarantee Full User Form View is Always Default Over Simple Profile -->
    <record id="base.view_users_form" model="ir.ui.view">
        <field name="priority">1</field>
    </record>
    <record id="base.view_users_form_simple_modif" model="ir.ui.view">
        <field name="priority">99</field>
    </record>

    <!-- User Form View Extension -->
    <record id="view_users_form_signature_card" model="ir.ui.view">
        <field name="name">res.users.form.signature.card</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mark_employee_left" string="Mark as Left" type="object"
                        class="crm_btn_mark_left" groups="base.group_system"
                        invisible="not id or not employee_id or is_left_employee or id == 2"
                        confirm="Are you sure you want to mark this employee as Left?"/>
                <button name="action_mark_employee_active" string="Mark as Active" type="object"
                        class="crm_btn_mark_active" groups="base.group_system"
                        invisible="not id or not is_left_employee or id == 2"
                        confirm="Are you sure you want to re-activate this employee?"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="is_left_employee" invisible="1"/>
                <widget name="web_ribbon" title="Left Employee" bg_color="text-bg-danger"
                        invisible="not is_left_employee"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <!-- Tab: Organization & Hierarchy -->
                <page string="Organization &amp; Hierarchy" name="org_hierarchy_page">
                    <group>
                        <!-- Left Column -->
                        <group string="Role &amp; Hierarchy">
                            <field name="is_manager_role" invisible="1"/>
                            <field name="is_department_head" invisible="1"/>
                            <field name="crm_job_id" string="Job Position / Role" readonly="is_department_head" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="crm_manager_id" string="Reports To (Manager)" options="{'no_create': True, 'no_open': True}"/>
                            <field name="crm_expense_manager_id" string="Voucher Approver" options="{'no_create': True, 'no_open': True}"/>
                            <field name="crm_department_id" string="Department" readonly="is_department_head" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <div colspan="2" invisible="not is_department_head" class="alert alert-info py-1 px-2 mb-2 small">
                                <i class="fa fa-shield me-1"/> <strong>Department Head:</strong> Position &amp; Department are managed directly from Department / Job Master.
                            </div>
                            <field name="crm_department_ids" widget="many2many_tags"
                                   string="Managed Sub-Departments"
                                   invisible="not is_manager_role"
                                   domain="[('id', '!=', crm_department_id)]"
                                   options="{'color_field': 'color', 'no_create': True}"
                                   placeholder="Select sub-departments managed by this employee..."/>
                        </group>
                        <!-- Right Column --> 
                        <group string="Employee Profile &amp; Tags">
                            <field name="crm_employee_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True, 'no_create_edit': True}" placeholder="Select tags..."/>
                            <field name="employee_id" readonly="1" string="Linked Employee Profile"/>
                        </group>
                    </group>

                    <!-- Subordinates / Direct Reports Table (Styled Clean Modern Card) -->
                    <div invisible="not crm_subordinate_ids" class="mt-4 pt-3 border-top">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h4 class="text-uppercase fw-bold text-muted mb-0" style="font-size: clamp(0.85rem, 1vw, 0.95rem); letter-spacing: 0.05em;">
                                Subordinates &amp; Direct Reports
                            </h4>
                        </div>
                        <field name="crm_subordinate_ids" nolabel="1" readonly="1" class="subordinates_clean_table">
                            <list create="false" edit="false" delete="false">
                                <field name="name" string="Member Name"/>
                                <field name="crm_job_id" string="Job Position / Role"/>
                                <field name="crm_department_id" string="Department"/>
                                <field name="email" string="Work Email"/>
                            </list>
                        </field>
                    </div>
                </page>

                <page string="Quotation Signature Card" name="signature_card_page">
                    <group>
                        <field name="x_signature_card" widget="image" options="{'size': [350, 200]}"/>
                    </group>
                    <p class="text-muted">
                        Upload the business card / signature image to appear at the bottom of quotations sent by this user.
                    </p>
                </page>
            </xpath>


            <!-- 1. Place Configuration & Masters AFTER the Roles & Companies group -->
            <xpath expr="//page[@name='access_rights']//group[1]" position="after">
                <group string="Configuration &amp; Masters">
                    <div colspan="2" invisible="not custom_perm_override" class="alert alert-warning d-flex align-items-center justify-content-between mb-3 py-2 px-3" role="status">
                        <div>
                            <i class="fa fa-info-circle me-1"/>
                            <strong>Custom User Permissions:</strong> This user has custom permissions. Changes made to the Job Position / Role Master will <strong>not</strong> overwrite this user.
                        </div>
                        <button name="action_reset_job_permissions" type="object" string="Reset to Role Defaults" class="btn btn-sm btn-outline-danger" confirm="Are you sure you want to reset this user's permissions back to the Job Position defaults?"/>
                    </div>
                    <group>
                        <field name="custom_perm_override" invisible="1"/>
                        <field name="perm_lead_quote" string="Lead &amp; Quotation"/>
                        <field name="perm_service_ticket" string="Service Ticket"/>
                        <field name="perm_amc" string="AMC Contract"/>
                        <field name="perm_equipment" string="Equipment Master"/>
                        <field name="perm_company" string="Company Creation"/>
                        <field name="perm_export" string="Excel Export"/>
                        <field name="perm_log" string="Log View"/>
                        <field name="perm_margin" string="Show Margin"/>
                    </group>
                    
                    <group>
                        <label for="perm_customer_create" string="Customer Creation"/>
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_customer_create" nolabel="1"/> Create</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_customer_write" nolabel="1"/> Update</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_customer_read" nolabel="1"/> View</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_customer_unlink" nolabel="1"/> Delete</span>
                        </div>

                        <label for="perm_equipment_create" string="Equipment Master"/>
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_equipment_create" nolabel="1"/> Create</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_equipment_write" nolabel="1"/> Update</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_equipment_read" nolabel="1"/> View</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_equipment_unlink" nolabel="1"/> Delete</span>
                        </div>

                        <label for="perm_ticket_create" string="Service Ticket"/>
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_ticket_create" nolabel="1"/> Create</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_ticket_write" nolabel="1"/> Update</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_ticket_read" nolabel="1"/> View</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_ticket_unlink" nolabel="1"/> Delete</span>
                        </div>

                        <label for="perm_amc_create" string="AMC Contract"/>
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_amc_create" nolabel="1"/> Create</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_amc_write" nolabel="1"/> Update</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_amc_read" nolabel="1"/> View</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_amc_unlink" nolabel="1"/> Delete</span>
                        </div>

                        <label for="perm_product_create" string="Product"/>
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_product_create" nolabel="1"/> Create</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_product_write" nolabel="1"/> Update</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_product_read" nolabel="1"/> View</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_product_unlink" nolabel="1"/> Delete</span>
                        </div>

                        <label for="perm_exhibition_create" string="Exhibition Database"/>
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_exhibition_create" nolabel="1"/> Create</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_exhibition_write" nolabel="1"/> Update</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_exhibition_read" nolabel="1"/> View</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_exhibition_unlink" nolabel="1"/> Delete</span>
                        </div>

                        <label for="perm_lead_create" string="Lead &amp; Quotation"/>
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_lead_create" nolabel="1"/> Create</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_lead_write" nolabel="1"/> Update</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_lead_read" nolabel="1"/> View</span>
                            <span class="d-inline-flex align-items-center gap-1"><field name="perm_lead_unlink" nolabel="1"/> Delete</span>
                        </div>
                    </group>
                </group>
            </xpath>

        </field>
    </record>

    <!-- Clean Unified Roles & Groups (hr.job) Form View -->
    <record id="view_hr_job_form_crm_clean" model="ir.ui.view">
        <field name="name">hr.job.form.crm.clean</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="replace">
                <group>
                    <group string="Organization &amp; Department Scope">
                        <field name="department_id" string="Primary Department" options="{'no_create': True, 'no_open': True}"/>
                        <field name="is_manager_role" string="Is Manager / Head " widget="boolean_toggle" groups="base.group_erp_manager"/>
                        <field name="default_manager_id" string="Reporting Manager" readonly="1" force_save="1" options="{'no_create': True, 'no_open': True}"/>
                        <field name="sub_department_ids" widget="many2many_tags" 
                               string="Managed Sub-Departments"
                               domain="[('parent_id', '!=', False), ('id', '!=', department_id)]"
                               options="{'color_field': 'color', 'no_create': True}"
                               placeholder="Optional: sub-departments managed under this role..."/>
                        <field name="company_id" string="Company" placeholder="Global (All Companies)"/>
                    </group>
                    <group string="Job Position Hierarchy">
                        <field name="job_hierarchy_html" nolabel="1" widget="html"/>
                    </group>
                </group>

                <notebook>
                    <!-- TAB 1: Assigned Employees (Subordinate Team) -->
                    <page string="Assigned Employees" name="assigned_employees_page" invisible="is_manager_role">
                        <field name="assigned_employee_ids" nolabel="1" class="assigned_employees_table assigned_employees_view" options="{'no_create': True}">
                            <list string="Assigned Employees" delete="false" open_form_view="False">
                                <field name="id" column_invisible="1"/>
                                <field name="custom_perm_override" column_invisible="1"/>
                                <field name="name" string="Employee Name" readonly="1"/>
                                <field name="login" string="Work Email" readonly="1"/>
                                <field name="crm_department_id" string="Department" readonly="1"/>
                                <field name="crm_manager_id" string="Reports To" readonly="1"/>
                                <field name="access_status_badge_html" widget="html" string="Access Status" readonly="1"/>
                                <button name="action_reset_user_permissions"
                                        type="object"
                                        icon="fa-refresh"
                                        title="Reset to Standard Role"
                                        aria-label="Reset to Standard Role"
                                        context="{'active_id': id, 'default_user_id': id, 'user_id': id}"
                                        invisible="not custom_perm_override"
                                        class="btn btn-sm btn-outline-warning p-1"/>
                                <button name="action_open_user_permissions"
                                        type="object"
                                        icon="fa-sliders"
                                        title="Access Control"
                                        aria-label="Access Control"
                                        context="{'active_id': id, 'default_user_id': id, 'user_id': id}"
                                        class="btn btn-sm btn-outline-primary p-1"/>
                                <button name="action_view_user_hierarchy"
                                        type="object"
                                        icon="fa-sitemap"
                                        title="View Reporting Hierarchy"
                                        aria-label="View Reporting Hierarchy"
                                        context="{'active_id': id, 'default_user_id': id, 'user_id': id}"
                                        class="btn btn-sm btn-outline-secondary p-1"/>
                                <button name="action_revoke_role" 
                                        type="object" 
                                        icon="fa-trash"
                                        title="Revoke Role"
                                        aria-label="Revoke Role"
                                        context="{'active_id': id, 'default_user_id': id, 'user_id': id}"
                                        class="btn btn-sm btn-outline-danger p-1" 
                                        confirm="Are you sure you want to revoke this position from this employee?"
                                        help="Remove this role from the employee."/>
                            </list>
                        </field>
                    </page>

                    <!-- TAB 1 (Alternative for Manager Roles): Shows assigned managers with hierarchy button -->
                    <page string="Manager Profile" name="manager_profile_page" invisible="not is_manager_role">
                        <field name="assigned_employee_ids" nolabel="1" class="assigned_employees_table manager_profile_view" options="{'no_create': True}">
                            <list string="Department Managers" delete="false" editable="bottom" open_form_view="False">
                                <field name="id" column_invisible="1"/>
                                <field name="custom_perm_override" column_invisible="1"/>
                                <field name="name" string="Manager Name" readonly="1"/>
                                <field name="login" string="Work Email" readonly="1"/>
                                <field name="crm_department_id" string="Department" readonly="1"/>
                                <field name="crm_department_ids" widget="many2many_tags" string="Managed Sub-Departments" placeholder="None (Own Dept Only)" options="{'no_create': True}"/>
                                <field name="crm_manager_id" string="Reports To" readonly="1"/>
                                <field name="access_status_badge_html" widget="html" string="Access Status" readonly="1"/>
                                <button name="action_reset_user_permissions"
                                        type="object"
                                        icon="fa-refresh"
                                        title="Reset to Standard Role"
                                        aria-label="Reset to Standard Role"
                                        context="{'active_id': id, 'default_user_id': id, 'user_id': id}"
                                        invisible="not custom_perm_override"
                                        class="btn btn-sm btn-outline-warning p-1"/>
                                <button name="action_open_user_permissions"
                                        type="object"
                                        icon="fa-sliders"
                                        title="Access Control"
                                        aria-label="Access Control"
                                        context="{'active_id': id, 'default_user_id': id, 'user_id': id}"
                                        class="btn btn-sm btn-outline-primary p-1"/>
                                <button name="action_view_user_hierarchy"
                                        type="object"
                                        icon="fa-sitemap"
                                        title="View Reporting Hierarchy"
                                        aria-label="View Reporting Hierarchy"
                                        context="{'active_id': id, 'default_user_id': id, 'user_id': id}"
                                        class="btn btn-sm btn-outline-secondary p-1"/>
                                <button name="action_revoke_role" 
                                        type="object" 
                                        icon="fa-trash"
                                        title="Revoke Role"
                                        aria-label="Revoke Role"
                                        context="{'active_id': id, 'default_user_id': id, 'user_id': id}"
                                        class="btn btn-sm btn-outline-danger p-1" 
                                        confirm="Are you sure you want to revoke this position from this employee?"
                                        help="Remove this role from the manager."/>
                            </list>
                        </field>
                    </page>

                    <!-- TAB 2: Permissions Matrix -->
                    <page string="Permissions" name="permissions_page">
                        
                        <!-- SECTION 1: Record Access & Visibility -->
                        <div class="o_horizontal_separator text-uppercase fw-bold text-primary mb-3" style="font-size: 13px; letter-spacing: 0.5px;">
                            Record Access &amp; Visibility Filters
                        </div>
                        <group class="custom_radio_clean">
                            <field name="perm_lead_quote" widget="radio" options="{'horizontal': true}"/>
                            <field name="perm_equipment" widget="radio" options="{'horizontal': true}"/>
                            <field name="perm_service_ticket" widget="radio" options="{'horizontal': true}"/>
                            <field name="perm_amc" widget="radio" options="{'horizontal': true}"/>
                        </group>

                        <!-- SECTION 2: Master Data Actions -->
                        <div class="d-flex align-items-center justify-content-between mt-4 mb-3 pb-1 border-bottom">
                            <div class="text-uppercase fw-bold text-primary" style="font-size: 13px; letter-spacing: 0.5px;">
                                Master Data Operations
                            </div>
                            <div class="d-flex align-items-center">
                                <field name="perm_master_select_all" nolabel="1" class="me-1"/>
                                <span class="fw-bold text-dark small">Select All Masters</span>
                            </div>
                        </div>

                        <group class="custom_radio_clean">
                            <label for="perm_customer_create" string="Customer Master"/>
                            <div class="perm-checkbox-group">
                                <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_customer_all" nolabel="1"/> <span>All</span></span>
                                <span class="perm-checkbox-item"><field name="perm_customer_create" nolabel="1"/> <span>Create</span></span>
                                <span class="perm-checkbox-item"><field name="perm_customer_write" nolabel="1"/> <span>Update</span></span>
                                <span class="perm-checkbox-item"><field name="perm_customer_read" nolabel="1"/> <span>View</span></span>
                                <span class="perm-checkbox-item"><field name="perm_customer_unlink" nolabel="1"/> <span>Delete</span></span>
                            </div>

                            <label for="perm_equipment_create" string="Equipment Master"/>
                            <div class="perm-checkbox-group">
                                <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_equipment_all" nolabel="1"/> <span>All</span></span>
                                <span class="perm-checkbox-item"><field name="perm_equipment_create" nolabel="1"/> <span>Create</span></span>
                                <span class="perm-checkbox-item"><field name="perm_equipment_write" nolabel="1"/> <span>Update</span></span>
                                <span class="perm-checkbox-item"><field name="perm_equipment_read" nolabel="1"/> <span>View</span></span>
                                <span class="perm-checkbox-item"><field name="perm_equipment_unlink" nolabel="1"/> <span>Delete</span></span>
                            </div>

                            <label for="perm_ticket_create" string="Service Ticket"/>
                            <div class="perm-checkbox-group">
                                <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_ticket_all" nolabel="1"/> <span>All</span></span>
                                <span class="perm-checkbox-item"><field name="perm_ticket_create" nolabel="1"/> <span>Create</span></span>
                                <span class="perm-checkbox-item"><field name="perm_ticket_write" nolabel="1"/> <span>Update</span></span>
                                <span class="perm-checkbox-item"><field name="perm_ticket_read" nolabel="1"/> <span>View</span></span>
                                <span class="perm-checkbox-item"><field name="perm_ticket_unlink" nolabel="1"/> <span>Delete</span></span>
                            </div>

                            <label for="perm_amc_create" string="AMC Contract"/>
                            <div class="perm-checkbox-group">
                                <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_amc_all" nolabel="1"/> <span>All</span></span>
                                <span class="perm-checkbox-item"><field name="perm_amc_create" nolabel="1"/> <span>Create</span></span>
                                <span class="perm-checkbox-item"><field name="perm_amc_write" nolabel="1"/> <span>Update</span></span>
                                <span class="perm-checkbox-item"><field name="perm_amc_read" nolabel="1"/> <span>View</span></span>
                                <span class="perm-checkbox-item"><field name="perm_amc_unlink" nolabel="1"/> <span>Delete</span></span>
                            </div>

                            <label for="perm_product_create" string="Product"/>
                            <div class="perm-checkbox-group">
                                <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_product_all" nolabel="1"/> <span>All</span></span>
                                <span class="perm-checkbox-item"><field name="perm_product_create" nolabel="1"/> <span>Create</span></span>
                                <span class="perm-checkbox-item"><field name="perm_product_write" nolabel="1"/> <span>Update</span></span>
                                <span class="perm-checkbox-item"><field name="perm_product_read" nolabel="1"/> <span>View</span></span>
                                <span class="perm-checkbox-item"><field name="perm_product_unlink" nolabel="1"/> <span>Delete</span></span>
                            </div>

                            <label for="perm_exhibition_create" string="Exhibition Database"/>
                            <div class="perm-checkbox-group">
                                <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_exhibition_all" nolabel="1"/> <span>All</span></span>
                                <span class="perm-checkbox-item"><field name="perm_exhibition_create" nolabel="1"/> <span>Create</span></span>
                                <span class="perm-checkbox-item"><field name="perm_exhibition_write" nolabel="1"/> <span>Update</span></span>
                                <span class="perm-checkbox-item"><field name="perm_exhibition_read" nolabel="1"/> <span>View</span></span>
                                <span class="perm-checkbox-item"><field name="perm_exhibition_unlink" nolabel="1"/> <span>Delete</span></span>
                            </div>

                            <label for="perm_lead_create" string="Lead &amp; Quotation"/>
                            <div class="perm-checkbox-group">
                                <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_lead_all" nolabel="1"/> <span>All</span></span>
                                <span class="perm-checkbox-item"><field name="perm_lead_create" nolabel="1"/> <span>Create</span></span>
                                <span class="perm-checkbox-item"><field name="perm_lead_write" nolabel="1"/> <span>Update</span></span>
                                <span class="perm-checkbox-item"><field name="perm_lead_read" nolabel="1"/> <span>View</span></span>
                                <span class="perm-checkbox-item"><field name="perm_lead_unlink" nolabel="1"/> <span>Delete</span></span>
                            </div>
                        </group>

                        <!-- SECTION 3: System Actions -->
                        <div class="o_horizontal_separator text-uppercase fw-bold text-primary mt-4 mb-3" style="font-size: 13px; letter-spacing: 0.5px;">
                            System Actions &amp; Export
                        </div>
                        <group class="custom_radio_clean">
                            <field name="perm_export" widget="radio" options="{'horizontal': true}"/>
                            <field name="perm_log" widget="radio" options="{'horizontal': true}"/>
                            <field name="perm_company" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Employee Form View Extension: Add Expense / Voucher Approver -->
    <record id="view_employee_form_crm_custom" model="ir.ui.view">
        <field name="name">hr.employee.form.crm.custom</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="expense_manager_id" string="Expense / Voucher Approver" widget="many2one_avatar_user"/>
            </xpath>
        </field>
    </record>

    <!-- Department Form View Extension -->
    <record id="view_department_form_crm_hierarchy" model="ir.ui.view">
        <field name="name">hr.department.form.crm.hierarchy</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='manager_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='manager_id']" position="after">
                <field name="manager_user_id" string="Department Head" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
            </xpath>
            <xpath expr="//widget[@name='hr_department_chart']" position="replace">
                <group string="Department Organization" class="dept_hierarchy_col">
                    <field name="department_hierarchy_html" nolabel="1" widget="html"/>
                </group>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Department Members" name="dept_members_page">
                        <group>
                            <field name="member_user_ids" widget="many2many_tags" readonly="1" string="Department Members"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Clean Organization Chart Wizard Form View -->
    <record id="view_crm_user_hierarchy_wizard_form" model="ir.ui.view">
        <field name="name">crm.user.hierarchy.wizard.form</field>
        <field name="model">crm.user.hierarchy.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporting Hierarchy">
                <sheet>
                    <field name="hierarchy_html" nolabel="1" widget="html"/>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Clean User Custom Access Control Wizard Form View -->
    <record id="view_crm_user_access_control_wizard_form" model="ir.ui.view">
        <field name="name">crm.user.access.control.wizard.form</field>
        <field name="model">crm.user.access.control.wizard</field>
        <field name="arch" type="xml">
            <form string="Custom Access Control">
                <sheet>
                    <div class="alert alert-info d-flex align-items-center justify-content-between mb-3 py-2 px-3" role="status">
                        <div>
                            <i class="fa fa-user me-2 text-primary"/>
                            <strong>Employee: </strong> <field name="user_name" class="fw-bold me-3"/>
                            <i class="fa fa-envelope me-1 text-muted"/>
                            <field name="user_login" class="text-muted me-3"/>
                            <i class="fa fa-briefcase me-1 text-muted"/>
                            <strong>Role: </strong> <field name="crm_job_id" class="fw-semibold"/>
                        </div>
                    </div>
                    <field name="user_id" invisible="1"/>

                    <!-- SECTION 1: Record Access & Visibility -->
                    <div class="o_horizontal_separator text-uppercase fw-bold text-primary mb-3" style="font-size: 13px; letter-spacing: 0.5px;">
                        Record Access &amp; Visibility Filters
                    </div>
                    <group class="custom_radio_clean">
                        <field name="perm_lead_quote" widget="radio" options="{'horizontal': true}"/>
                        <field name="perm_equipment" widget="radio" options="{'horizontal': true}"/>
                        <field name="perm_service_ticket" widget="radio" options="{'horizontal': true}"/>
                        <field name="perm_amc" widget="radio" options="{'horizontal': true}"/>
                    </group>

                    <!-- SECTION 2: Master Data Operations -->
                    <div class="d-flex align-items-center justify-content-between mt-4 mb-3 pb-1 border-bottom">
                        <div class="text-uppercase fw-bold text-primary" style="font-size: 13px; letter-spacing: 0.5px;">
                            Master Data Operations
                        </div>
                        <div class="d-flex align-items-center">
                            <field name="perm_master_select_all" nolabel="1" class="me-1"/>
                            <span class="fw-bold text-dark small">Select All Masters</span>
                        </div>
                    </div>

                    <group class="custom_radio_clean">
                        <label for="perm_customer_create" string="Customer Master"/>
                        <div class="perm-checkbox-group">
                            <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_customer_all" nolabel="1"/> <span>All</span></span>
                            <span class="perm-checkbox-item"><field name="perm_customer_create" nolabel="1"/> <span>Create</span></span>
                            <span class="perm-checkbox-item"><field name="perm_customer_write" nolabel="1"/> <span>Update</span></span>
                            <span class="perm-checkbox-item"><field name="perm_customer_read" nolabel="1"/> <span>View</span></span>
                            <span class="perm-checkbox-item"><field name="perm_customer_unlink" nolabel="1"/> <span>Delete</span></span>
                        </div>

                        <label for="perm_equipment_create" string="Equipment Master"/>
                        <div class="perm-checkbox-group">
                            <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_equipment_all" nolabel="1"/> <span>All</span></span>
                            <span class="perm-checkbox-item"><field name="perm_equipment_create" nolabel="1"/> <span>Create</span></span>
                            <span class="perm-checkbox-item"><field name="perm_equipment_write" nolabel="1"/> <span>Update</span></span>
                            <span class="perm-checkbox-item"><field name="perm_equipment_read" nolabel="1"/> <span>View</span></span>
                            <span class="perm-checkbox-item"><field name="perm_equipment_unlink" nolabel="1"/> <span>Delete</span></span>
                        </div>

                        <label for="perm_ticket_create" string="Service Ticket"/>
                        <div class="perm-checkbox-group">
                            <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_ticket_all" nolabel="1"/> <span>All</span></span>
                            <span class="perm-checkbox-item"><field name="perm_ticket_create" nolabel="1"/> <span>Create</span></span>
                            <span class="perm-checkbox-item"><field name="perm_ticket_write" nolabel="1"/> <span>Update</span></span>
                            <span class="perm-checkbox-item"><field name="perm_ticket_read" nolabel="1"/> <span>View</span></span>
                            <span class="perm-checkbox-item"><field name="perm_ticket_unlink" nolabel="1"/> <span>Delete</span></span>
                        </div>

                        <label for="perm_amc_create" string="AMC Contract"/>
                        <div class="perm-checkbox-group">
                            <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_amc_all" nolabel="1"/> <span>All</span></span>
                            <span class="perm-checkbox-item"><field name="perm_amc_create" nolabel="1"/> <span>Create</span></span>
                            <span class="perm-checkbox-item"><field name="perm_amc_write" nolabel="1"/> <span>Update</span></span>
                            <span class="perm-checkbox-item"><field name="perm_amc_read" nolabel="1"/> <span>View</span></span>
                            <span class="perm-checkbox-item"><field name="perm_amc_unlink" nolabel="1"/> <span>Delete</span></span>
                        </div>

                        <label for="perm_product_create" string="Product"/>
                        <div class="perm-checkbox-group">
                            <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_product_all" nolabel="1"/> <span>All</span></span>
                            <span class="perm-checkbox-item"><field name="perm_product_create" nolabel="1"/> <span>Create</span></span>
                            <span class="perm-checkbox-item"><field name="perm_product_write" nolabel="1"/> <span>Update</span></span>
                            <span class="perm-checkbox-item"><field name="perm_product_read" nolabel="1"/> <span>View</span></span>
                            <span class="perm-checkbox-item"><field name="perm_product_unlink" nolabel="1"/> <span>Delete</span></span>
                        </div>

                        <label for="perm_exhibition_create" string="Exhibition Database"/>
                        <div class="perm-checkbox-group">
                            <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_exhibition_all" nolabel="1"/> <span>All</span></span>
                            <span class="perm-checkbox-item"><field name="perm_exhibition_create" nolabel="1"/> <span>Create</span></span>
                            <span class="perm-checkbox-item"><field name="perm_exhibition_write" nolabel="1"/> <span>Update</span></span>
                            <span class="perm-checkbox-item"><field name="perm_exhibition_read" nolabel="1"/> <span>View</span></span>
                            <span class="perm-checkbox-item"><field name="perm_exhibition_unlink" nolabel="1"/> <span>Delete</span></span>
                        </div>

                        <label for="perm_lead_create" string="Lead &amp; Quotation"/>
                        <div class="perm-checkbox-group">
                            <span class="perm-checkbox-item fw-bold text-primary pe-2 border-end"><field name="perm_lead_all" nolabel="1"/> <span>All</span></span>
                            <span class="perm-checkbox-item"><field name="perm_lead_create" nolabel="1"/> <span>Create</span></span>
                            <span class="perm-checkbox-item"><field name="perm_lead_write" nolabel="1"/> <span>Update</span></span>
                            <span class="perm-checkbox-item"><field name="perm_lead_read" nolabel="1"/> <span>View</span></span>
                            <span class="perm-checkbox-item"><field name="perm_lead_unlink" nolabel="1"/> <span>Delete</span></span>
                        </div>
                    </group>

                    <!-- SECTION 3: System Actions -->
                    <div class="o_horizontal_separator text-uppercase fw-bold text-primary mt-4 mb-3" style="font-size: 13px; letter-spacing: 0.5px;">
                        System Actions &amp; Export
                    </div>
                    <group class="custom_radio_clean">
                        <field name="perm_export" widget="radio" options="{'horizontal': true}"/>
                        <field name="perm_log" widget="radio" options="{'horizontal': true}"/>
                        <field name="perm_company" widget="radio" options="{'horizontal': true}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save_and_apply" string="Save &amp; Apply Custom Access" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
