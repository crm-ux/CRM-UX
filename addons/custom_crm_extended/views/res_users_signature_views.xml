<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Simple Job Position Form for Quick Creation (Name only, no permissions) -->
    <record id="view_hr_job_simple_crm_form" model="ir.ui.view">
        <field name="name">hr.job.simple.crm.form</field>
        <field name="model">hr.job</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form string="Create Job Position / Role">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Job Position"/>
                        <h1><field name="name" placeholder="e.g. Sales Executive"/></h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 1. User Form View Extension -->
    <record id="view_users_form_signature_card" model="ir.ui.view">
        <field name="name">res.users.form.signature.card</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- Tab: Organization & Hierarchy -->
                <page string="Organization &amp; Hierarchy" name="org_hierarchy_page">
                    <group>
                        <!-- Left Column -->
                        <group string="Role &amp; Hierarchy">
                            <field name="crm_job_id" string="Job Position / Role" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="crm_manager_id" string="Reports To (Manager)" options="{'no_create': True, 'no_open': True}"/>
                            <field name="crm_expense_manager_id" string="Expense / Voucher Approver" options="{'no_create': True, 'no_open': True}"/>
                            <field name="crm_department_id" string="Department" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        </group>
                        <!-- Right Column -->
                        <group string="Employee Profile &amp; Tags">
                            <field name="crm_employee_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True, 'no_create_edit': True}" placeholder="Select tags..."/>
                            <field name="employee_id" readonly="1" string="Linked Employee Profile"/>
                        </group>
                    </group>
                </page>

                <page string="Quotation Signature Card" name="signature_card_page">
                    <group>
                        <field name="x_signature_card" widget="image" options="{'size': [350, 200]}"/>
                    </group>
                    <p class="text-muted">
                        Upload the business card / signature image to appear at the bottom of quotations sent by this user.
                    </p>
                </page>
            </xpath>
        </field>
    </record>

        <!-- Roles & Groups: Tree View -->
    <record id="view_crm_role_access_tree" model="ir.ui.view">
        <field name="name">crm.role.access.tree</field>
        <field name="model">crm.role.access</field>
        <field name="arch" type="xml">
            <tree string="Roles &amp; Groups">
                <field name="job_id"/>
                <field name="perm_lead_quote"/>
                <field name="perm_contact"/>
                <field name="perm_product"/>
                <field name="user_count"/>
            </tree>
        </field>
    </record>

    <!-- Roles & Groups: Form View (Job Position dropdown + Core CRM Permissions) -->
    <record id="view_crm_role_access_form" model="ir.ui.view">
        <field name="name">crm.role.access.form</field>
        <field name="model">crm.role.access</field>
        <field name="arch" type="xml">
            <form string="Role &amp; Group Permissions">
                <sheet>
                    <div class="oe_title">
                        <label for="job_id" string="Job Position / Role"/>
                        <h1>
                            <field name="job_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" placeholder="Select Job Position..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Core CRM Permissions">
                            <field name="perm_lead_quote" widget="radio"/>
                            <field name="perm_contact" widget="radio"/>
                            <field name="perm_product" widget="radio"/>
                        </group>
                        <group string="Assigned Users">
                            <field name="user_count" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- 2. Employee Form View Extension: Add Expense / Voucher Approver -->
    <record id="view_employee_form_crm_custom" model="ir.ui.view">
        <field name="name">hr.employee.form.crm.custom</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="expense_manager_id" string="Expense / Voucher Approver" widget="many2one_avatar_user"/>
            </xpath>
        </field>
    </record>
</odoo>
