<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_amc_contract_form" model="ir.ui.view">
        <field name="name">amc.contract.form</field>
        <field name="model">amc.contract</field>
        <field name="arch" type="xml">
            <form string="Annual Maintenance Contract" js_class="amc_form">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="AMC No."/>
                        <h1>
                            <field name="name" placeholder="AMC No."/>
                        </h1>
                    </div>

                    <group>
                        <!-- Row 1: Customer/company name | Date -->
                        <group>
                            <field name="partner_id" default_focus="1" string="Customer / Company Name"/>
                        </group>
                        <group>
                            <field name="date"/>
                        </group>

                        <!-- Row 2: Customer address | Status -->
                        <group>
                            <field name="customer_address" rows="1"/>
                        </group>
                        <group>
                            <field name="contract_status" class="custom_radio_clean" widget="radio" options="{'horizontal': true}"/>
                        </group>

                        <!-- Row 3: Location | GST -->
                        <group>
                            <field name="location" string="Location"/>
                        </group>
                        <group>
                            <field name="gstin" string="GSTIN"/>
                        </group>

                        <!-- Row 4: Mobile | Warranty start date -->
                        <group>
                            <field name="mobile" string="Mobile"/>
                        </group>
                        <group>
                            <field name="warranty_start_date" string="Warranty Start Date"/>
                        </group>

                        <!-- Row 5: Email | Warranty end date -->
                        <group>
                            <field name="email" string="Email"/>
                        </group>
                        <group>
                            <field name="warranty_end_date" string="Warranty End Date"/>
                        </group>

                        <!-- Row 6: Contact person | Contract start date -->
                        <group>
                            <field name="contact_person" string="Contact Person"/>
                        </group>
                        <group>
                            <field name="contract_start_date"/>
                        </group>

                        <!-- Row 7: Contract value | Contract end date -->
                        <group>
                            <field name="contract_value"/>
                        </group>
                        <group>
                            <field name="contract_end_date"/>
                        </group>

                        <!-- Row 8: PM | Renewal terms -->
                        <group>
                            <field name="pm" string="PM"/>
                        </group>
                        <group>
                            <field name="renewal_terms"/>
                        </group>

                        <!-- Row 9: Breakdown | Payment terms -->
                        <group>
                            <field name="cm" string="Breakdown"/>
                        </group>
                        <group>
                            <field name="payment_terms"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Equipment Details" name="equipment_lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="equipment_id" options="{'no_create': True}" domain="['|', ('partner_id', '=', parent.partner_id), ('partner_id.parent_id', '=', parent.partner_id)]"/>
                                    <field name="make"/>
                                    <field name="part_no"/>
                                    <field name="serial_no"/>
                                    <field name="location"/>
                                    <field name="end_user"/>
                                    <field name="mobile"/>
                                    <field name="email"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree / List View -->
    <record id="view_amc_contract_tree" model="ir.ui.view">
        <field name="name">amc.contract.tree</field>
        <field name="model">amc.contract</field>
        <field name="arch" type="xml">
            <list string="Annual Maintenance Contracts">
                <field name="name" readonly="1"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="contract_start_date"/>
                <field name="contract_end_date"/>
                <field name="contract_value"/>
                <field name="contract_status" widget="badge" 
                    decoration-success="contract_status == 'active'" 
                    decoration-info="contract_status == 'draft'" 
                    decoration-warning="contract_status == 'renewed'" 
                    decoration-danger="contract_status in ('expired', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_amc_contract" model="ir.actions.act_window">
        <field name="name">Annual Maintenance Contracts</field>
        <field name="res_model">amc.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'clear_breadcrumbs': True}</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_amc_contract_root" name="AMC Contracts" action="action_amc_contract" sequence="26"/>

    <!-- Hide Company on AMC Numbering Series Form -->
    <record id="view_sequence_form_amc_hide_company" model="ir.ui.view">
        <field name="name">ir.sequence.form.amc.hide.company</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view"/>
        <field name="arch" type="xml">
            <field name="company_id" position="attributes">
                <attribute name="invisible">code == 'amc.contract'</attribute>
            </field>
        </field>
    </record>

</odoo>
