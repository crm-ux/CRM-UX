<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_amc_contract_form" model="ir.ui.view">
        <field name="name">amc.contract.form</field>
        <field name="model">amc.contract</field>
        <field name="arch" type="xml">
            <form string="Annual Maintenance Contract" js_class="amc_form">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="AMC No."/>
                        <h1>
                            <field name="name" placeholder="AMC No."/>
                        </h1>
                    </div>

                    <group>
                        <!-- Row 1: Date | Customer / Company Name -->
                        <group>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="partner_id" default_focus="1" string="Customer / Company Name"/>
                        </group>

                        <!-- Row 2: Status | Customer Address -->
                        <group>
                            <field name="contract_status" class="custom_radio_clean" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="customer_address" rows="1"/>
                        </group>

                        <!-- Row 3: GST | Location -->
                        <group>
                            <field name="gst"/>
                        </group>
                        <group>
                            <field name="location" string="Location"/>
                        </group>

                        <!-- Row 4: Start Date | Mobile -->
                        <group>
                            <field name="contract_start_date"/>
                        </group>
                        <group>
                            <field name="mobile" string="Mobile"/>
                        </group>

                        <!-- Row 5: End Date | Email -->
                        <group>
                            <field name="contract_end_date"/>
                        </group>
                        <group>
                            <field name="email" string="Email"/>
                        </group>

                        <!-- Row 6: Renewal Terms | Contact Person -->
                        <group>
                            <field name="renewal_terms"/>
                        </group>
                        <group>
                            <field name="contact_person" string="Contact Person"/>
                        </group>

                        <!-- Row 7: Payment Terms | Contract Value -->
                        <group>
                            <field name="payment_terms"/>
                        </group>
                        <group>
                            <field name="contract_value"/>
                        </group>

                        <!-- Row 8: PM | CM -->
                        <group>
                            <field name="pm" string="PM"/>
                        </group>
                        <group>
                            <field name="cm" string="CM"/>
                        </group>
                    </group>


                    <notebook>
                        <page string="Equipment Details" name="equipment_lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="equipment_id" options="{'no_create': True}"/>
                                    <field name="make"/>
                                    <field name="part_no"/>
                                    <field name="serial_no"/>
                                    <field name="location"/>
                                    <field name="end_user"/>
                                    <field name="mobile"/>
                                    <field name="email"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tree / List View -->
    <record id="view_amc_contract_tree" model="ir.ui.view">
        <field name="name">amc.contract.tree</field>
        <field name="model">amc.contract</field>
        <field name="arch" type="xml">
            <list string="Annual Maintenance Contracts">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="contract_start_date"/>
                <field name="contract_end_date"/>
                <field name="contract_value"/>
                <field name="contract_status" widget="badge" 
                    decoration-success="contract_status == 'active'" 
                    decoration-info="contract_status == 'draft'" 
                    decoration-warning="contract_status == 'renewed'" 
                    decoration-danger="contract_status in ('expired', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_amc_contract" model="ir.actions.act_window">
        <field name="name">Annual Maintenance Contracts</field>
        <field name="res_model">amc.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'clear_breadcrumbs': True}</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_amc_contract_root" name="AMC Contracts" action="action_amc_contract" sequence="26"/>
</odoo>
