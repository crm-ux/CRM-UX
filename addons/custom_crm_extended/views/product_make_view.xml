<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_make_field" model="ir.ui.view">
        <field name="name">product.template.make.field</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>

        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="x_make" string="Make / Brand"/>
            </xpath>
        </field>
    </record>

    <!-- Hide Parent Category in Product Category Form & Quick Create -->
    <record id="product_category_hide_parent_view" model="ir.ui.view">
        <field name="name">product.category.hide.parent</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
