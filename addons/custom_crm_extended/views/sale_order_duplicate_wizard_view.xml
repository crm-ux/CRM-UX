<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_duplicate_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.duplicate.wizard.form</field>
        <field name="model">sale.order.duplicate.wizard</field>
        <field name="arch" type="xml">
            <form string="Duplicate Quotation">
                <div style="width: 100%; max-width: 92vw; padding: 0.5rem 0;">
                    <group>
                        <field name="order_id" invisible="1"/>
                        <field name="partner_id" string="Customer" required="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                        <field name="contact_person_id" string="Contact Person" options="{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                        <field name="user_id" string="Salesperson" options="{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                    </group>
                </div>
                <footer>
                    <button name="action_duplicate" string="Duplicate" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_order_duplicate_wizard" model="ir.actions.act_window">
        <field name="name">Duplicate Quotation</field>
        <field name="res_model">sale.order.duplicate.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sale_order_duplicate_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'medium'}</field>
    </record>
</odoo>
