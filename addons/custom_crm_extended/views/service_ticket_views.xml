<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Service Ticket Form View -->
    <record id="view_service_ticket_form" model="ir.ui.view">
        <field name="name">service.ticket.form</field>
        <field name="model">service.ticket</field>
        <field name="arch" type="xml">
            <form string="Service Ticket" js_class="service_ticket_form">
                <header>
                    <!-- Left: Next action buttons (one by one) -->
                    <button name="action_move_to_contacted" string="Contacted" type="object" class="btn btn-secondary"
                        invisible="ticket_status not in ('new', 'open')"/>
                    <button name="action_move_to_ongoing" string="Ongoing" type="object" class="btn btn-secondary"
                        invisible="ticket_status != 'contacted'"/>
                    <button name="action_move_to_pending" string="Pending" type="object" class="btn btn-secondary"
                        invisible="ticket_status != 'ongoing'"/>
                    <button name="action_move_to_ongoing" string="Resume Ongoing" type="object" class="btn btn-secondary"
                        invisible="ticket_status != 'pending'"/>
                    <button name="action_move_to_closed" string="Close" type="object" class="btn btn-secondary"
                        invisible="ticket_status not in ('ongoing', 'pending')"/>
                    <button name="action_reopen" string="Reopen" type="object" class="btn btn-secondary"
                        invisible="ticket_status != 'closed'"/>

                    <!-- Right: Dynamic single stage badge -->
                    <field name="stage_visible" invisible="1"/>
                    <field name="ticket_status" widget="statusbar" options="{'clickable': '0'}"/>
                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <label for="ticket_id" class="oe_edit_only" string="Ticket ID"/>
                        <h1>
                            <field name="ticket_id" placeholder="e.g. ST-2026-001"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Ticket Information">
                            <field name="ticket_datetime"/>
                            <field name="complaint_type" widget="radio" options="{'horizontal': true}" class="custom_radio_clean"/>
                            <field name="priority" widget="radio" options="{'horizontal': true}" class="custom_radio_clean"/>
                        </group>
                        <group string="Customer Information">
                            <field name="partner_id" context="{'show_equipment_serial': True}"/>
                            <field name="site_name"/>
                            <field name="contact_person"/>
                            <field name="contact_number"/>
                            <field name="email"/>
                        </group>
                    </group>

                    <group>
                        <group string="Equipment Details">
                            <field name="equipment_id"/>
                            <field name="model_number"/>
                            <field name="serial_number"/>
                            <field name="part_number"/>
                            <field name="company_id" options="{'no_create': True}" placeholder="Leave empty for all companies"/>
                        </group>
                        <group string="Assignment &amp; Schedule">
                            <field name="engineer_id"/>
                            <field name="engineer_contact"/>
                            <field name="engineer_email"/>
                            <field name="visit_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Complaint Details" name="complaint_tab">
                            <group>
                                <field name="complaint_description" string="Complaint Description" placeholder="Describe the problem reported by the customer..." />
                            </group>
                        </page>
                        <page string="Resolution &amp; Spares" name="resolution_tab">
                            <group>
                                <group string="Action Taken">
                                    <field name="root_cause" string="Root Cause" placeholder="e.g. Compressor failure" />
                                    <field name="corrective_action" string="Corrective Action" placeholder="e.g. Compressor replaced" />
                                    <field name="spare_parts_used"/>
                                </group>
                                <group string="Service Timings">
                                    <field name="service_start_time"/>
                                    <field name="service_end_time"/>
                                </group>
                            </group>
                        </page>
                        <!-- <page string="Signatures" name="signatures_tab">
                            <group>
                                <group string="Customer Sign-off">
                                    <field name="customer_signature" widget="image"/>
                                </group>
                                <group string="Engineer Sign-off">
                                    <field name="engineer_signature" widget="image"/>
                                </group>
                            </group>
                        </page> -->
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Service Ticket List/Tree View -->
    <record id="view_service_ticket_tree" model="ir.ui.view">
        <field name="name">service.ticket.tree</field>
        <field name="model">service.ticket</field>
        <field name="arch" type="xml">
            <list string="Service Tickets">
                <field name="ticket_id" string="Ticket ID"/>
                <field name="ticket_datetime"/>
                <field name="partner_id"/>
                <field name="equipment_id"/>
                <field name="complaint_type"/>
                <field name="priority"/>
                <field name="engineer_id"/>
                <field name="visit_date"/>
                <field name="ticket_status" widget="badge" decoration-info="ticket_status == 'open'" decoration-warning="ticket_status == 'ongoing'" decoration-success="ticket_status == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- Service Ticket Search View -->
    <record id="view_service_ticket_search" model="ir.ui.view">
        <field name="name">service.ticket.search</field>
        <field name="model">service.ticket</field>
        <field name="arch" type="xml">
            <search string="Service Tickets">
                <field name="ticket_id" string="Ticket ID"/>
                <field name="partner_id"/>
                <field name="equipment_id"/>
                <field name="engineer_id"/>
                <filter string="Open" name="open" domain="[('ticket_status', '=', 'open')]"/>
                <filter string="On Going" name="ongoing" domain="[('ticket_status', '=', 'ongoing')]"/>
                <filter string="Closed" name="closed" domain="[('ticket_status', '=', 'closed')]"/>
                <separator/>
                <filter string="High Priority" name="high_priority" domain="[('priority', '=', 'high')]"/>
                <group>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'ticket_status'}"/>
                    <filter string="Engineer" name="group_engineer" context="{'group_by': 'engineer_id'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>



    <!-- Action -->
    <record id="action_service_ticket" model="ir.actions.act_window">
        <field name="name">Service Tickets</field>
        <field name="res_model">service.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_service_ticket_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Service Ticket
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_service_ticket_root" name="Service Tickets" action="action_service_ticket" sequence="26"/>
</odoo>
