<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Equipment Master Form View -->
    <record id="view_equipment_master_form" model="ir.ui.view">
        <field name="name">equipment.master.form</field>
        <field name="model">equipment.master</field>
        <field name="arch" type="xml">
            <form string="Equipment Master" js_class="equipment_form">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_service_ticket" type="object" class="oe_stat_button" icon="fa-wrench">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Service Ticket</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="equipment_id" class="oe_edit_only" string="Equipment ID"/>
                        <h1>
                            <field name="equipment_id" placeholder="e.g. LT000123"/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="e.g. Genpure Refrigerator"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Basic Information">
                            <field name="category_id"/>
                            <field name="manufacturer"/>
                            <field name="model_number"/>
                            <field name="serial_number"/>
                            <field name="part_number"/>
                            <field name="child_part_no"/>
                            <field name="criticality" widget="radio" options="{'horizontal': true}" class="custom_radio_clean"/>
                            <field name="equipment_status" widget="radio" options="{'horizontal': true}" class="custom_radio_clean" string="Equipment Status"/>

                        </group>
                        <group string="Customer Location &amp; Contact">
                            <field name="partner_id"/>
                            <field name="contact_person"/>
                            <field name="contact_number"/>
                            <field name="email"/>
                            <field name="site_name"/>
                            <field name="building"/>
                            <field name="floor"/>
                            <field name="department"/>
                            <field name="room_number"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Maintenance &amp; Contract" name="maintenance_tab">
                            <group>
                                <group string="Dates &amp; Contract">
                                    <field name="installation_date"/>
                                    <field name="warranty_start_date"/>
                                    <field name="warranty_end_date"/>
                                    <field name="service_contract"/>
                                </group>
                                <group string="Maintenance Status">
                                    <field name="running_status" widget="radio" class="custom_radio_clean" options="{'horizontal': true}"/>
                                    <field name="last_preventive_maintenance"/>
                                    <field name="next_preventive_maintenance"/>
                                    <field name="last_breakdown_date"/>
                                    <field name="calibration_due_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Specs &amp; Remarks" name="specs_tab">
                            <group>
                                <field name="firmware_version"/>
                                <field name="address"/>
                                <field name="accessories"/>
                                <field name="remarks"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Equipment Master List/Tree View -->
    <record id="view_equipment_master_tree" model="ir.ui.view">
        <field name="name">equipment.master.tree</field>
        <field name="model">equipment.master</field>
        <field name="arch" type="xml">
            <list string="Equipment Master">
                <field name="equipment_id"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="manufacturer"/>
                <field name="model_number"/>
                <field name="serial_number"/>
                <field name="partner_id"/>
                <field name="site_name"/>
                <field name="equipment_status" widget="badge" decoration-success="equipment_status == 'active'" decoration-warning="equipment_status == 'under_repair'" decoration-danger="equipment_status == 'inactive'"/>
                <field name="running_status"/>
                <field name="criticality"/>
            </list>
        </field>
    </record>

    <!-- Equipment Master Search View -->
    <record id="view_equipment_master_search" model="ir.ui.view">
        <field name="name">equipment.master.search</field>
        <field name="model">equipment.master</field>
        <field name="arch" type="xml">
            <search string="Equipment Master">
                <field name="equipment_id"/>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="partner_id"/>
                <filter string="Active" name="active" domain="[('equipment_status', '=', 'active')]"/>
                <filter string="Under Repair" name="under_repair" domain="[('equipment_status', '=', 'under_repair')]"/>
                <filter string="Running" name="running" domain="[('running_status', '=', 'running')]"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'equipment_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_equipment_master" model="ir.actions.act_window">
        <field name="name">Equipment Master</field>
        <field name="res_model">equipment.master</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_equipment_master_root" name="Equipment Master" action="action_equipment_master" sequence="25"/>
</odoo>
