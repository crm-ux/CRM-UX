<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_service_ticket" model="ir.sequence">
            <field name="name">Service Ticket Sequence</field>
            <field name="code">service.ticket.seq</field>
            <field name="prefix">SRV-%(year)s-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Pre-loaded Complaint Types -->
        <record id="complaint_type_breakdown" model="service.ticket.complaint.type">
            <field name="name">Breakdown</field>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
        </record>
        <record id="complaint_type_pm" model="service.ticket.complaint.type">
            <field name="name">PM</field>
            <field name="sequence">20</field>
            <field name="active" eval="True"/>
        </record>
        <record id="complaint_type_free_call" model="service.ticket.complaint.type">
            <field name="name">Free Call</field>
            <field name="sequence">30</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
